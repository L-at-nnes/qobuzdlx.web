@inject LocalizationService Loc
@inject IJSRuntime JS

@* Bascule FR | EN. Aucun rechargement de page : celui-ci détruirait le circuit Blazor, donc le
   déverrouillage par mot de passe (AppGuardService est scoped), et redemanderait le mot de passe à
   chaque changement de langue. Les composants affichés se redessinent via l'événement
   LocalizationService.OnLanguageChanged, et l'attribut <html lang> est mis à jour en JS. *@
<div class="lang-switch">
    <button type="button" class="@(Loc.Current == LocalizationService.French ? "active" : "")"
            @onclick='() => Switch(LocalizationService.French)'>FR</button>
    <span class="lang-switch-sep">|</span>
    <button type="button" class="@(Loc.Current == LocalizationService.English ? "active" : "")"
            @onclick='() => Switch(LocalizationService.English)'>EN</button>
</div>

@code {
    private async Task Switch(string lang)
    {
        if (Loc.Current == lang) return;

        Loc.SetLanguage(lang);
        await JS.InvokeVoidAsync("setHtmlLang", Loc.Current);
    }
}
