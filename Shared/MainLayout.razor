@inherits LayoutComponentBase
@using Microsoft.AspNetCore.WebUtilities
@inject QobuzApiService Api
@inject SettingsService Settings
@inject AppGuardService Guard
@inject LocalizationService Loc
@inject DownloadService Download
@implements IDisposable

@{
    var needsPassword = !string.IsNullOrEmpty(Settings.Settings.AppAccessPasswordHash);
    var isLocked = needsPassword && !Guard.IsUnlocked;
}

@if (isLocked)
{
    <div id="app">
        <div class="auth-shell">
            <div class="auth-card">
                <div class="card">
                    <div style="text-align:center;margin-bottom:20px;">
                        <h2 style="color:var(--accent);font-size:1.8em;">QBDLX</h2>
                        <p style="color:var(--text-secondary);font-size:0.85em;">@Loc["lock.subtitle"]</p>
                    </div>

                    @if (Guard.IsLockedOut)
                    {
                        <div style="background:rgba(231,76,60,0.15);border:1px solid #c0392b;border-radius:6px;padding:10px;margin-bottom:12px;font-size:0.85em;color:#e74c3c;">
                            @Loc.P("lock.retrySeconds", Guard.RemainingSeconds)
                        </div>
                    }
                    else if (_lockError)
                    {
                        <div style="background:rgba(231,76,60,0.15);border:1px solid #c0392b;border-radius:6px;padding:10px;margin-bottom:12px;font-size:0.85em;color:#e74c3c;">
                            @Loc["lock.wrongPassword"]
                        </div>
                    }

                    @* Formulaire HTML classique, et non @onsubmit : il fonctionne dès le prérendu,
                       sans attendre que le circuit SignalR soit établi — sur un réseau lent, cela
                       évite un bouton qui reste inerte plusieurs secondes. Le champ nommé se fait
                       aussi reconnaître par le gestionnaire de mots de passe du téléphone. *@
                    <form method="post" action="/auth/unlock">
                        <input type="hidden" name="returnUrl" value="@_returnUrl" />
                        <div class="form-group">
                            <label for="access-password">@Loc["lock.password"]</label>
                            <input id="access-password" name="password" type="password" autocomplete="current-password" placeholder='@Loc["lock.passwordPlaceholder"]' autofocus disabled="@Guard.IsLockedOut" />
                        </div>
                        <button type="submit" class="btn btn-primary" style="width:100%;margin-top:8px;" disabled="@Guard.IsLockedOut">@Loc["lock.unlock"]</button>
                    </form>
                </div>
                <LanguageSwitch />
            </div>
        </div>
    </div>
}
else
{
    <div id="app">
        @if (!Api.IsLoggedIn)
        {
            <div class="auth-shell">
                @Body
                <LanguageSwitch />
            </div>
        }
        else
        {
            @* Barre supérieure et voile : masqués par CSS au-dessus de 768px, où la barre
               latérale reprend sa place dans le flux. *@
            <header class="app-topbar">
                <button class="topbar-burger" @onclick="ToggleMenu" aria-label='@Loc["nav.menu"]'>&#9776;</button>
                <span class="topbar-title">QBDLX</span>
            </header>
            <div class="sidebar-backdrop @(_menuOpen ? "open" : "")" @onclick="CloseMenu"></div>

            <nav class="sidebar @(_menuOpen ? "open" : "")">
                <div class="sidebar-logo">QBDLX</div>
                <div class="sidebar-user">
                    <strong>@Settings.Settings.UserDisplayName</strong>
                    @if (!string.IsNullOrEmpty(Settings.Settings.UserLabel))
                    {
                        <span class="user-label">@Settings.Settings.UserLabel</span>
                    }
                </div>
                <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">@Loc["nav.search"]</NavLink>
                @* Le libellé est enveloppé dans un <span> : entre deux éléments, l'espacement du
                   source est ignoré par le flex, alors qu'un nœud texte nu deviendrait un item
                   anonyme avec ses blancs d'indentation. *@
                <NavLink class="nav-link" href="/telechargement">
                    <span>@Loc["nav.download"]</span>
                    @if (Download.RemainingCount > 0)
                    {
                        <span class="nav-badge">@Download.RemainingCount</span>
                    }
                </NavLink>
                <NavLink class="nav-link" href="/settings">@Loc["nav.settings"]</NavLink>
                <div class="nav-spacer"></div>
                <button class="nav-link" @onclick="Logout">@Loc["nav.logout"]</button>
                <LanguageSwitch />
                <div class="sidebar-version">v@(AppInfo.Version)</div>
            </nav>
            <div class="main-content">
                @Body
            </div>
        }
    </div>
}

@code {
    private bool _lockError;

    // Chemin à réafficher après le POST de déverrouillage, pour ne pas ramener systématiquement
    // à l'accueil quelqu'un qui rouvrait la page Téléchargement.
    private string _returnUrl = "/";

    // Tiroir de navigation : n'a d'effet que sous 768px, où le CSS sort la barre latérale du flux.
    private bool _menuOpen;

    [Inject] NavigationManager NavigationManager { get; set; } = default!;

    // Le layout est un LayoutComponentBase : il ne peut pas hériter de LocalizedComponentBase et
    // s'abonne donc lui-même au changement de langue (barre latérale, écran de verrouillage).
    protected override void OnInitialized()
    {
        // Le déverrouillage étant un POST suivi d'une redirection, l'échec ne peut revenir que
        // par l'URL. Le cas « throttled » n'a pas besoin d'être lu ici : Guard.IsLockedOut, qui
        // interroge désormais un état applicatif et non le circuit, l'expose déjà.
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        _lockError = QueryHelpers.ParseQuery(uri.Query).TryGetValue("lock", out var lockState)
                     && lockState == "bad";
        // Sans la query : la tentative suivante ne doit pas réinjecter ?lock=bad dans returnUrl.
        _returnUrl = string.IsNullOrEmpty(uri.LocalPath) ? "/" : uri.LocalPath;

        Loc.OnLanguageChanged += OnLanguageChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
        // OnQueueChanged et non OnProgressChanged : la pastille n'a besoin de savoir que lorsque la
        // file change, quelques fois par minute. L'autre événement redessinerait la barre latérale
        // de tous les circuits ouverts à chaque bloc de 80 Ko reçu.
        Download.OnQueueChanged += OnQueueChanged;
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    private void OnQueueChanged() => InvokeAsync(StateHasChanged);

    // Un seul point de branchement pour refermer le tiroir après une navigation, plutôt qu'un
    // @onclick sur chacun des liens.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!_menuOpen) return;
        _menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void CloseMenu() => _menuOpen = false;

    public void Dispose()
    {
        Loc.OnLanguageChanged -= OnLanguageChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
        Download.OnQueueChanged -= OnQueueChanged;
    }

    private void Logout()
    {
        Settings.ClearQobuzSession();
        Api.SetCredentials("", "", "");
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}
