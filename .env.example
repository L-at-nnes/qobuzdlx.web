# Copy to .env to change a setting. Everything here is optional.

# Port of the interface on this machine
PORT=8080

# Password of the interface (8 characters at least). Recommended as soon as the machine can be
# reached by anyone else. Leave it empty to choose one in the settings instead.
ACCESS_PASSWORD=

# Where the music goes. A name keeps it in a Docker volume; a path puts it in that folder of the host,
# which must belong to uid 65532 (chown -R 65532 /srv/music).
DOWNLOADS_DIR=downloads

# true only behind a reverse proxy that serves the interface over HTTPS
COOKIE_SECURE=false
