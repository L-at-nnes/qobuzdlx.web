@page "/telechargement"
@page "/downloader"
@inject DownloadService Download
@inject SettingsService Settings
@inject QobuzApiService Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@inherits LocalizedComponentBase

@* Instantanés pris UNE fois par rendu : les collections vives du service sont mutées par le worker
   sur un autre thread, les énumérer directement lèverait « Collection was modified ». Il en va de
   même pour l'album en cours : le worker le remet à null en fin d'élément, et le lire une fois pour
   le tester puis une seconde fois pour l'afficher ferait lever une NullReferenceException. *@
@{
    var queue = Download.QueueSnapshot();
    var log = Download.LogSnapshot();
    var firstPending = queue.FirstOrDefault(i => i.Status == QueueItemStatus.Pending);
    var lastPending = queue.LastOrDefault(i => i.Status == QueueItemStatus.Pending);
    var pendingCount = queue.Count(i => i.Status == QueueItemStatus.Pending);
    var finishedCount = queue.Count(i => i.IsFinished);
    var album = Download.Progress.CurrentAlbum;
}

<h3 style="margin-bottom:16px;">@Loc["download.title"]</h3>

<!-- URL Input -->
<div class="card">
    <div class="url-bar">
        @* Plus aucun disabled lié au téléchargement en cours : c'est tout l'objet de la file. *@
        <input type="text" @bind="_inputUrl" @bind:event="oninput" placeholder='@Loc["download.urlPlaceholder"]' @onkeydown="OnKeyDown" />
        <button class="btn btn-primary" @onclick="StartDownload" disabled="@string.IsNullOrWhiteSpace(_inputUrl)">@Loc["download.start"]</button>
        <button class="btn btn-secondary" @onclick="() => _showBatch = !_showBatch">@Loc["download.batch"]</button>
    </div>

    @if (_showBatch)
    {
        <div style="margin-top:8px;">
            <textarea @bind="_batchUrls" rows="5" placeholder='@Loc["download.batchPlaceholder"]' style="resize:vertical;"></textarea>
            <button class="btn btn-primary btn-sm" style="margin-top:8px;" @onclick="StartBatch">@Loc["download.batchStart"]</button>
        </div>
    }

    <div style="margin-top:10px;font-size:0.8em;color:var(--text-secondary);">
        @Loc["download.qualityLabel"] <strong>@QualityLabel</strong> — <a href="/settings">@Loc["download.qualityEdit"]</a>
    </div>
</div>

<!-- File d'attente : placée avant la carte album pour être visible sans défiler. -->
<div class="card">
    <div class="card-title">
        <span>@Loc["queue.title"]</span>
        @if (queue.Count > 0)
        {
            <span class="queue-count">@Loc.P("queue.count", queue.Count)</span>
        }
        <div class="queue-toolbar">
            @if (pendingCount > 0)
            {
                <button class="btn btn-secondary btn-sm" @onclick="Download.ClearPending">@Loc["queue.clearPending"]</button>
            }
            @if (finishedCount > 0)
            {
                <button class="btn btn-secondary btn-sm" @onclick="Download.ClearFinished">@Loc["queue.clearFinished"]</button>
            }
        </div>
    </div>

    @if (queue.Count == 0)
    {
        <div class="queue-empty">@Loc["queue.empty"]</div>
    }
    else
    {
        <div class="queue-list">
            @* @key est indispensable : sans lui, réordonner fait réutiliser les nœuds en place par
               Blazor et les états disabled des flèches se désynchronisent de la ligne affichée. *@
            @foreach (var it in queue)
            {
                <div class="queue-row @RowClass(it)" @key="it.Id">
                    @if (!string.IsNullOrEmpty(it.Thumbnail))
                    {
                        <img src="@it.Thumbnail" alt="" />
                    }
                    else
                    {
                        <div class="queue-thumb-placeholder">@(Loc[$"queue.kind.{it.Kind}"])</div>
                    }

                    <div class="queue-info">
                        <div class="title">@it.Label</div>
                        @if (!string.IsNullOrEmpty(it.SubLabel))
                        {
                            <div class="sub">@it.SubLabel</div>
                        }
                        @if (it.Status == QueueItemStatus.Failed && !string.IsNullOrEmpty(it.Error))
                        {
                            <div class="err">@it.Error</div>
                        }
                        @if (it.Downloaded + it.Skipped + it.Failures.Count > 0)
                        {
                            <div class="sub">@Loc.T("queue.summary", it.Downloaded, it.Skipped, it.Failures.Count)</div>
                        }
                        @if (it.Failures.Count > 0)
                        {
                            <details class="queue-failures">
                                <summary>@Loc.P("queue.failures", it.Failures.Count)</summary>
                                <ul>
                                    @foreach (var failure in it.Failures.Take(MaxFailuresShown))
                                    {
                                        <li><strong>@failure.Title</strong> — @failure.Error</li>
                                    }
                                    @if (it.Failures.Count > MaxFailuresShown)
                                    {
                                        <li>@Loc.T("queue.failuresMore", it.Failures.Count - MaxFailuresShown)</li>
                                    }
                                </ul>
                            </details>
                        }
                    </div>

                    <span class="queue-status @RowClass(it)">@(Loc[$"queue.status.{StatusKey(it.Status)}"])</span>

                    @* Jamais plus de trois boutons par ligne, quel que soit l'état : c'est ce qui
                       rend la ligne tenable à 375px. *@
                    <div class="queue-actions">
                        @if (it.Status == QueueItemStatus.Running)
                        {
                            <button class="btn btn-danger btn-sm" @onclick="Download.CancelCurrent" title='@Loc["queue.cancelCurrentHint"]'>@Loc["download.cancel"]</button>
                            <button class="btn btn-secondary btn-sm" @onclick="Download.SkipCurrent" title='@Loc["queue.skipHint"]'>@Loc["download.skip"]</button>
                        }
                        else if (it.Status == QueueItemStatus.Pending)
                        {
                            <button class="queue-btn" @onclick="() => Download.MoveUp(it.Id)" disabled="@(it == firstPending)" title='@Loc["queue.action.up"]'>&#9650;</button>
                            <button class="queue-btn" @onclick="() => Download.MoveDown(it.Id)" disabled="@(it == lastPending)" title='@Loc["queue.action.down"]'>&#9660;</button>
                            <button class="queue-btn danger" @onclick="() => Download.Remove(it.Id)" title='@Loc["queue.action.remove"]'>&#10005;</button>
                        }
                        else
                        {
                            @if (it.Failures.Count > 0)
                            {
                                <button class="btn btn-secondary btn-sm" @onclick="() => Download.RetryFailures(it.Id)" title='@Loc["queue.retryFailuresHint"]'>@Loc["queue.retryFailures"]</button>
                            }
                            <button class="queue-btn" @onclick="() => Download.Retry(it.Id)" title='@Loc["queue.action.retry"]'>&#8635;</button>
                            <button class="queue-btn danger" @onclick="() => Download.Remove(it.Id)" title='@Loc["queue.action.remove"]'>&#10005;</button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Album Info + Progress -->
@if (album != null)
{
    <div class="card">
        <div class="album-info">
            @if (!string.IsNullOrEmpty(album.Image?.Large))
            {
                <img src="@album.Image.Large" alt="Cover" />
            }
            <div class="album-details">
                <h3>@album.Title @(album.Version != null ? $"({album.Version})" : "")</h3>
                <p>@album.Artist?.Name</p>
                <p>@album.ReleaseDateOriginal &middot; @Loc.P("search.trackCount", album.TracksCount)</p>
                <p>@album.Genre?.Name &middot; @album.Label?.Name</p>
                <p style="font-size:0.8em;color:var(--text-secondary);">@(album.MaximumBitDepth)bit / @(album.MaximumSamplingRate)kHz</p>
            </div>
        </div>
    </div>
}

<!-- Progress Bar -->
@if (Download.IsRunning)
{
    <div class="card">
        <div style="display:flex;justify-content:space-between;font-size:0.85em;margin-bottom:4px;">
            <span>@Download.Progress.Status</span>
            <span>@Download.Progress.Speed</span>
        </div>
        <div class="progress-bar-container">
            <div class="progress-bar-fill" style="width:@(Download.Progress.Percent)%"></div>
            <span class="progress-bar-text">@(Download.Progress.Percent)%</span>
        </div>
        @if (!string.IsNullOrEmpty(Download.Progress.CurrentItem))
        {
            <div style="font-size:0.85em;color:var(--text-secondary);margin-top:4px;">@Download.Progress.CurrentItem</div>
        }
    </div>
}

<!-- Log -->
<div class="card">
    <div class="card-title">
        <span>@Loc["download.log"]</span>
        @if (log.Count > 0)
        {
            <div class="queue-toolbar">
                <button class="btn btn-secondary btn-sm" @onclick="Download.ClearLog">@Loc["queue.clearLog"]</button>
            </div>
        }
    </div>
    <div class="log-output" @ref="_logRef">
        @foreach (var line in log)
        {
            <div>@line</div>
        }
        @if (log.Count == 0)
        {
            <div style="color:var(--text-secondary);">@Loc["download.logEmpty"]</div>
        }
    </div>
</div>

@code {
    // Au-delà, la liste des échecs d'un artiste de plusieurs centaines de pistes noierait la page.
    private const int MaxFailuresShown = 50;

    private string _inputUrl = "";
    private string _batchUrls = "";
    private bool _showBatch;
    private ElementReference _logRef;
    private int _lastLogCount = -1;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (!Api.IsLoggedIn) { Nav.NavigateTo("/login"); return; }
        Download.OnProgressChanged += OnProgress;
        Download.OnQueueChanged += OnProgress;
    }

    private void OnProgress() => InvokeAsync(StateHasChanged);

    // Le journal ne défilait pas : _logRef était déclaré mais jamais utilisé. Avec une file qui
    // enchaîne les éléments, le défaut devient criant.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var count = Download.LogCount;
        if (count == _lastLogCount) return;
        _lastLogCount = count;
        try { await JS.InvokeVoidAsync("scrollToBottom", _logRef); }
        catch (JSDisconnectedException) { /* circuit fermé pendant le rendu */ }
        catch (TaskCanceledException) { /* idem, côté interop */ }
    }

    // Fire-and-forget : Enqueue rend la main tout de suite, le worker de fond draine. C'est ce qui
    // permet de continuer à naviguer pendant un téléchargement.
    private void StartDownload()
    {
        if (string.IsNullOrWhiteSpace(_inputUrl)) return;
        // On ne vide le champ qu'en cas de succès : sur une URL invalide, l'utilisateur doit
        // pouvoir la corriger plutôt que la retaper.
        if (Download.Enqueue(_inputUrl.Trim()) != EnqueueResult.InvalidUrl)
            _inputUrl = "";
    }

    private void StartBatch()
    {
        var urls = _batchUrls.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(u => !string.IsNullOrWhiteSpace(u)).ToList();
        if (urls.Count == 0) return;
        Download.EnqueueMany(urls.Select(u => new QueueRequest(u)));
        _batchUrls = "";
    }

    // Le choix de la qualité vit désormais dans les Paramètres ; on n'affiche ici qu'un rappel.
    private string QualityLabel => Settings.Settings.QualityFormat switch
    {
        "5" => "MP3 320",
        "6" => "FLAC 16bit",
        "7" => "FLAC 24bit ≤96kHz",
        "27" => "FLAC 24bit 192kHz",
        _ => Loc["download.quality.unknown"]
    };

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") StartDownload();
    }

    private static string StatusKey(QueueItemStatus s) => s switch
    {
        QueueItemStatus.Pending => "pending",
        QueueItemStatus.Running => "running",
        QueueItemStatus.Completed => "done",
        QueueItemStatus.Failed => "failed",
        _ => "cancelled"
    };

    private static string RowClass(QueueItem it) => it.Status switch
    {
        QueueItemStatus.Running => "running",
        QueueItemStatus.Completed => "done",
        QueueItemStatus.Failed => "failed",
        QueueItemStatus.Cancelled => "cancelled",
        _ => ""
    };

    public override void Dispose()
    {
        base.Dispose();
        Download.OnProgressChanged -= OnProgress;
        Download.OnQueueChanged -= OnProgress;
    }
}
