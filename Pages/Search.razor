@page "/search"
@inject QobuzApiService Api
@inject DownloadService Download
@inject SettingsService Settings
@inject SearchStateService State

<h3 style="margin-bottom:16px;">Search</h3>

<div class="card">
    <div class="url-bar">
        <input type="text" @bind="State.Query" @bind:event="oninput" placeholder="Search albums, tracks or artists..." @onkeydown="OnKeyDown" />
        <button class="btn btn-primary" @onclick='() => DoSearch("albums")' disabled="@_searching">Albums</button>
        <button class="btn btn-secondary" @onclick='() => DoSearch("tracks")' disabled="@_searching">Tracks</button>
        <button class="btn btn-secondary" @onclick='() => DoSearch("artists")' disabled="@_searching">Artists</button>
    </div>
</div>

@if (_searching)
{
    <div class="card" style="text-align:center;color:var(--text-secondary);">Searching...</div>
}

@if (State.Albums != null && State.Albums.Count > 0)
{
    <div class="card">
        <div class="card-title">
            Albums (@State.Albums.Count results)
            <button class="btn btn-link btn-sm select-all-btn" @onclick="ToggleSelectAllAlbums">@(_selectedAlbums.Count == State.Albums.Count ? "Deselect All" : "Select All")</button>
        </div>
        <div class="search-results">
            @foreach (var album in State.Albums)
            {
                var albumId = album.Id;
                <div class="search-result-row @(_selectedAlbums.Contains(albumId) ? "selected" : "")">
                    <input type="checkbox" class="select-checkbox" checked="@_selectedAlbums.Contains(albumId)" @onchange="() => ToggleAlbum(albumId)" />
                    <img src="@album.Image?.Thumbnail" alt="" />
                    <div class="search-result-info">
                        <div class="title">@album.Title @(album.Version != null ? $"({album.Version})" : "")</div>
                        <div class="artist">@album.Artist?.Name &middot; @album.ReleaseDateOriginal &middot; @album.TracksCount tracks &middot; @(album.MaximumBitDepth)bit/@(album.MaximumSamplingRate)kHz</div>
                    </div>
                    <button class="btn btn-primary btn-sm" @onclick="() => DownloadAlbum(albumId)" disabled="@Download.IsRunning">Download</button>
                </div>
            }
        </div>
    </div>
}

@if (State.Tracks != null && State.Tracks.Count > 0)
{
    <div class="card">
        <div class="card-title">
            Tracks (@State.Tracks.Count results)
            <button class="btn btn-link btn-sm select-all-btn" @onclick="ToggleSelectAllTracks">@(_selectedTracks.Count == State.Tracks.Count ? "Deselect All" : "Select All")</button>
        </div>
        <div class="search-results">
            @foreach (var track in State.Tracks)
            {
                var trackId = track.Id;
                <div class="search-result-row @(_selectedTracks.Contains(trackId) ? "selected" : "")">
                    <input type="checkbox" class="select-checkbox" checked="@_selectedTracks.Contains(trackId)" @onchange="() => ToggleTrack(trackId)" />
                    <img src="@track.Album?.Image?.Thumbnail" alt="" />
                    <div class="search-result-info">
                        <div class="title">@track.Title @(track.Version != null ? $"({track.Version})" : "")</div>
                        <div class="artist">@track.Performer?.Name &middot; @track.Album?.Title &middot; @(track.MaximumBitDepth)bit/@(track.MaximumSamplingRate)kHz</div>
                    </div>
                    <button class="btn btn-primary btn-sm" @onclick="() => DownloadTrack(trackId)" disabled="@Download.IsRunning">Download</button>
                </div>
            }
        </div>
    </div>
}

@if (State.Artists != null && State.Artists.Count > 0)
{
    <div class="card">
        <div class="card-title">Artists (@State.Artists.Count results)</div>
        <div class="search-results">
            @foreach (var artist in State.Artists)
            {
                var artistId = artist.Id;
                var isExpanded = State.ExpandedArtistId == artistId;
                <div class="artist-block">
                    <div class="search-result-row artist-row @(isExpanded ? "expanded" : "")" @onclick="() => ToggleArtist(artistId)">
                        @if (!string.IsNullOrEmpty(artist.Picture))
                        {
                            <img src="@artist.Picture" alt="" class="artist-avatar" />
                        }
                        else
                        {
                            <div class="artist-avatar-placeholder">@(artist.Name?.Length > 0 ? artist.Name[0].ToString().ToUpper() : "?")</div>
                        }
                        <div class="search-result-info">
                            <div class="title">@artist.Name</div>
                            <div class="artist">@artist.AlbumsCount albums</div>
                        </div>
                        <span class="expand-icon">@(isExpanded ? "▾" : "▸")</span>
                        <button class="btn btn-primary btn-sm" @onclick="() => DownloadArtist(artistId)" @onclick:stopPropagation="true" disabled="@Download.IsRunning">Download All</button>
                    </div>

                    @if (isExpanded)
                    {
                        <div class="artist-albums">
                            @if (_loadingArtistAlbums)
                            {
                                <div class="artist-albums-loading">Loading albums...</div>
                            }
                            else if (State.ArtistAlbums != null && State.ArtistAlbums.Count > 0)
                            {
                                @foreach (var album in State.ArtistAlbums)
                                {
                                    var aId = album.Id;
                                    <div class="search-result-row artist-album-row @(_selectedAlbums.Contains(aId) ? "selected" : "")">
                                        <input type="checkbox" class="select-checkbox" checked="@_selectedAlbums.Contains(aId)" @onchange="() => ToggleAlbum(aId)" />
                                        <img src="@album.Image?.Thumbnail" alt="" />
                                        <div class="search-result-info">
                                            <div class="title">@album.Title @(album.Version != null ? $"({album.Version})" : "")</div>
                                            <div class="artist">@album.ReleaseDateOriginal &middot; @album.TracksCount tracks &middot; @(album.MaximumBitDepth)bit/@(album.MaximumSamplingRate)kHz</div>
                                        </div>
                                        <button class="btn btn-primary btn-sm" @onclick="() => DownloadAlbum(aId)" disabled="@Download.IsRunning">Download</button>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="artist-albums-loading">No albums found.</div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@if (TotalSelected > 0)
{
    <div class="selection-bar">
        <span>@TotalSelected selected</span>
        <button class="btn btn-primary btn-sm" @onclick="DownloadSelected" disabled="@Download.IsRunning">Download Selected</button>
        <button class="btn btn-secondary btn-sm" @onclick="ClearSelection">Clear</button>
    </div>
}

@code {
    private bool _searching;
    private bool _loadingArtistAlbums;
    private HashSet<string> _selectedAlbums = new();
    private HashSet<int> _selectedTracks = new();
    private int TotalSelected => _selectedAlbums.Count + _selectedTracks.Count;

    private async Task DoSearch(string type)
    {
        if (string.IsNullOrWhiteSpace(State.Query)) return;
        _searching = true;
        State.LastSearchType = type;
        State.Albums = null;
        State.Tracks = null;
        State.Artists = null;
        State.ExpandedArtistId = 0;
        State.ArtistAlbums = null;

        try
        {
            switch (type)
            {
                case "albums":
                    var albumResult = await Api.SearchAlbumsAsync(State.Query, 50);
                    State.Albums = albumResult?.Albums?.Items ?? new();
                    break;
                case "tracks":
                    var trackResult = await Api.SearchTracksAsync(State.Query, 50);
                    State.Tracks = trackResult?.Tracks?.Items ?? new();
                    break;
                case "artists":
                    var artistResult = await Api.SearchArtistsAsync(State.Query, 50);
                    State.Artists = artistResult?.Artists?.Items ?? new();
                    break;
            }
        }
        catch
        {
            State.Albums = null;
            State.Tracks = null;
            State.Artists = null;
        }
        finally
        {
            _searching = false;
        }
    }

    private async Task ToggleArtist(int artistId)
    {
        if (State.ExpandedArtistId == artistId)
        {
            State.ExpandedArtistId = 0;
            State.ArtistAlbums = null;
            return;
        }

        State.ExpandedArtistId = artistId;
        State.ArtistAlbums = null;
        _loadingArtistAlbums = true;
        StateHasChanged();

        try
        {
            var artist = await Api.GetArtistFullAsync(artistId.ToString());
            State.ArtistAlbums = artist.Albums?.Items ?? new();
        }
        catch
        {
            State.ArtistAlbums = new();
        }
        finally
        {
            _loadingArtistAlbums = false;
        }
    }

    private async Task DownloadAlbum(string albumId)
    {
        await Download.ProcessUrlAsync($"https://play.qobuz.com/album/{albumId}");
    }

    private async Task DownloadTrack(int trackId)
    {
        await Download.ProcessUrlAsync($"https://play.qobuz.com/track/{trackId}");
    }

    private async Task DownloadArtist(int artistId)
    {
        await Download.ProcessUrlAsync($"https://play.qobuz.com/artist/{artistId}");
    }

    private void ToggleAlbum(string id)
    {
        if (!_selectedAlbums.Remove(id)) _selectedAlbums.Add(id);
    }

    private void ToggleTrack(int id)
    {
        if (!_selectedTracks.Remove(id)) _selectedTracks.Add(id);
    }

    private void ToggleSelectAllAlbums()
    {
        if (State.Albums == null) return;
        if (_selectedAlbums.Count == State.Albums.Count)
            _selectedAlbums.Clear();
        else
            _selectedAlbums = new(State.Albums.Select(a => a.Id));
    }

    private void ToggleSelectAllTracks()
    {
        if (State.Tracks == null) return;
        if (_selectedTracks.Count == State.Tracks.Count)
            _selectedTracks.Clear();
        else
            _selectedTracks = new(State.Tracks.Select(t => t.Id));
    }

    private void ClearSelection()
    {
        _selectedAlbums.Clear();
        _selectedTracks.Clear();
    }

    private async Task DownloadSelected()
    {
        var urls = new List<string>();
        foreach (var id in _selectedAlbums)
            urls.Add($"https://play.qobuz.com/album/{id}");
        foreach (var id in _selectedTracks)
            urls.Add($"https://play.qobuz.com/track/{id}");

        ClearSelection();
        await Download.ProcessBatchAsync(urls);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoSearch(State.LastSearchType);
    }
}
