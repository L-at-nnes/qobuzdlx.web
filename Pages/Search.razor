@page "/"
@page "/search"
@using System.Net
@inject QobuzApiService Api
@inject DownloadService Download
@inject SettingsService Settings
@inject SearchStateService State
@inject NavigationManager Nav
@inject ILogger<Search> Logger
@inherits LocalizedComponentBase

<h3 style="margin-bottom:16px;">@Loc["search.title"]</h3>

<div class="card">
    <div class="url-bar">
        <input type="text" @bind="State.Query" @bind:event="oninput" placeholder='@Loc["search.placeholder"]' @onkeydown="OnKeyDown" />
        <button class="btn btn-primary" @onclick='() => DoSearch("albums")' disabled="@_searching">@Loc["search.albums"]</button>
        <button class="btn btn-secondary" @onclick='() => DoSearch("tracks")' disabled="@_searching">@Loc["search.tracks"]</button>
        <button class="btn btn-secondary" @onclick='() => DoSearch("artists")' disabled="@_searching">@Loc["search.artists"]</button>
    </div>
</div>

@if (_searching)
{
    <div class="card" style="text-align:center;color:var(--text-secondary);">@Loc["search.searching"]</div>
}

@if (_searchFailed)
{
    <div class="card" style="background:rgba(231,76,60,0.15);border:1px solid #c0392b;color:#e74c3c;">@Loc["search.error"]</div>
}
else if (HasNoResults)
{
    <div class="card" style="text-align:center;color:var(--text-secondary);">@Loc["search.noResults"]</div>
}

@if (State.Albums != null && State.Albums.Count > 0)
{
    <div class="card">
        <div class="card-title">
            @Loc["search.albums"] (@Loc.P("search.results", State.Albums.Count))
            <button class="btn btn-link btn-sm select-all-btn" @onclick="ToggleSelectAllAlbums">@(_selectedAlbums.Count == State.Albums.Count ? Loc["search.deselectAll"] : Loc["search.selectAll"])</button>
            <select class="sort-select" @bind="State.AlbumSort">
                <option value="@SearchSort.Relevance">@Loc["sort.relevance"]</option>
                <option value="@SearchSort.TitleAsc">@Loc["sort.titleAsc"]</option>
                <option value="@SearchSort.TitleDesc">@Loc["sort.titleDesc"]</option>
                <option value="@SearchSort.ArtistAsc">@Loc["sort.artistAsc"]</option>
                <option value="@SearchSort.ArtistDesc">@Loc["sort.artistDesc"]</option>
                <option value="@SearchSort.DateDesc">@Loc["sort.dateDesc"]</option>
                <option value="@SearchSort.DateAsc">@Loc["sort.dateAsc"]</option>
                <option value="@SearchSort.QualityDesc">@Loc["sort.qualityDesc"]</option>
                <option value="@SearchSort.CountDesc">@Loc["sort.tracksDesc"]</option>
                <option value="@SearchSort.CountAsc">@Loc["sort.tracksAsc"]</option>
                <option value="@SearchSort.LabelAsc">@Loc["sort.labelAsc"]</option>
            </select>
        </div>
        <div class="search-results">
            @foreach (var album in SearchSorter.SortAlbums(State.Albums, State.AlbumSort))
            {
                var albumId = album.Id;
                var albumUrl = AlbumUrl(albumId);
                <div class="search-result-row @(_selectedAlbums.Contains(albumId) ? "selected" : "")">
                    <input type="checkbox" class="select-checkbox" checked="@_selectedAlbums.Contains(albumId)" @onchange="() => ToggleAlbum(albumId)" />
                    <img src="@album.Image?.Thumbnail" alt="" />
                    <div class="search-result-info">
                        <div class="title">@album.Title @(album.Version != null ? $"({album.Version})" : "")</div>
                        <div class="artist">@album.Artist?.Name &middot; @album.ReleaseDateOriginal &middot; @Loc.P("search.trackCount", album.TracksCount) &middot; @(album.MaximumBitDepth)bit/@(album.MaximumSamplingRate)kHz</div>
                    </div>
                    @* La marque ✓ est FRÈRE du bouton, jamais enfant : à l'intérieur, la règle
                       `.search-result-row .btn::before` du palier 640px l'écraserait. *@
                    @if (Download.IsDone(albumUrl))
                    {
                        <span class="queue-done-mark" title='@Loc["queue.doneMark"]'>&#10003;</span>
                    }
                    <button class="btn btn-primary btn-sm" @onclick="() => QueueAlbum(album)" disabled="@Download.IsQueued(albumUrl)" title='@Loc["search.download"]'><span class="btn-label">@Loc["search.download"]</span></button>
                </div>
            }
        </div>
    </div>
}

@if (State.Tracks != null && State.Tracks.Count > 0)
{
    <div class="card">
        <div class="card-title">
            @Loc["search.tracks"] (@Loc.P("search.results", State.Tracks.Count))
            <button class="btn btn-link btn-sm select-all-btn" @onclick="ToggleSelectAllTracks">@(_selectedTracks.Count == State.Tracks.Count ? Loc["search.deselectAll"] : Loc["search.selectAll"])</button>
            <select class="sort-select" @bind="State.TrackSort">
                <option value="@SearchSort.Relevance">@Loc["sort.relevance"]</option>
                <option value="@SearchSort.TitleAsc">@Loc["sort.titleAsc"]</option>
                <option value="@SearchSort.TitleDesc">@Loc["sort.titleDesc"]</option>
                <option value="@SearchSort.ArtistAsc">@Loc["sort.artistAsc"]</option>
                <option value="@SearchSort.AlbumAsc">@Loc["sort.albumAsc"]</option>
                <option value="@SearchSort.DurationAsc">@Loc["sort.durationAsc"]</option>
                <option value="@SearchSort.DurationDesc">@Loc["sort.durationDesc"]</option>
                <option value="@SearchSort.QualityDesc">@Loc["sort.qualityDesc"]</option>
                <option value="@SearchSort.DateDesc">@Loc["sort.dateDesc"]</option>
            </select>
        </div>
        <div class="search-results">
            @foreach (var track in SearchSorter.SortTracks(State.Tracks, State.TrackSort))
            {
                var trackId = track.Id;
                var trackUrl = TrackUrl(trackId);
                <div class="search-result-row @(_selectedTracks.Contains(trackId) ? "selected" : "")">
                    <input type="checkbox" class="select-checkbox" checked="@_selectedTracks.Contains(trackId)" @onchange="() => ToggleTrack(trackId)" />
                    <img src="@track.Album?.Image?.Thumbnail" alt="" />
                    <div class="search-result-info">
                        <div class="title">@track.Title @(track.Version != null ? $"({track.Version})" : "")</div>
                        <div class="artist">@track.Performer?.Name &middot; @track.Album?.Title &middot; @(track.MaximumBitDepth)bit/@(track.MaximumSamplingRate)kHz</div>
                    </div>
                    @if (Download.IsDone(trackUrl))
                    {
                        <span class="queue-done-mark" title='@Loc["queue.doneMark"]'>&#10003;</span>
                    }
                    <button class="btn btn-primary btn-sm" @onclick="() => QueueTrack(track)" disabled="@Download.IsQueued(trackUrl)" title='@Loc["search.download"]'><span class="btn-label">@Loc["search.download"]</span></button>
                </div>
            }
        </div>
    </div>
}

@if (State.Artists != null && State.Artists.Count > 0)
{
    <div class="card">
        <div class="card-title">
            @Loc["search.artists"] (@Loc.P("search.results", State.Artists.Count))
            <select class="sort-select" @bind="State.ArtistSort">
                <option value="@SearchSort.Relevance">@Loc["sort.relevance"]</option>
                <option value="@SearchSort.TitleAsc">@Loc["sort.nameAsc"]</option>
                <option value="@SearchSort.TitleDesc">@Loc["sort.nameDesc"]</option>
                <option value="@SearchSort.CountDesc">@Loc["sort.albumsDesc"]</option>
                <option value="@SearchSort.CountAsc">@Loc["sort.albumsAsc"]</option>
            </select>
        </div>
        <div class="search-results">
            @foreach (var artist in SearchSorter.SortArtists(State.Artists, State.ArtistSort))
            {
                var artistId = artist.Id;
                var artistUrl = ArtistUrl(artistId);
                var isExpanded = State.ExpandedArtistId == artistId;
                <div class="artist-block">
                    <div class="search-result-row artist-row @(isExpanded ? "expanded" : "")" @onclick="() => ToggleArtist(artistId)">
                        @if (!string.IsNullOrEmpty(artist.Picture))
                        {
                            <img src="@artist.Picture" alt="" class="artist-avatar" />
                        }
                        else
                        {
                            <div class="artist-avatar-placeholder">@(artist.Name?.Length > 0 ? artist.Name[0].ToString().ToUpper() : "?")</div>
                        }
                        <div class="search-result-info">
                            <div class="title">@artist.Name</div>
                            <div class="artist">@Loc.P("search.albumCount", artist.AlbumsCount)</div>
                        </div>
                        <span class="expand-icon">@(isExpanded ? "▾" : "▸")</span>
                        @if (Download.IsDone(artistUrl))
                        {
                            <span class="queue-done-mark" title='@Loc["queue.doneMark"]'>&#10003;</span>
                        }
                        <button class="btn btn-primary btn-sm" @onclick="() => QueueArtist(artist)" @onclick:stopPropagation="true" disabled="@Download.IsQueued(artistUrl)" title='@Loc["search.downloadAll"]'><span class="btn-label">@Loc["search.downloadAll"]</span></button>
                    </div>

                    @if (isExpanded)
                    {
                        <div class="artist-albums">
                            @if (_loadingArtistAlbums)
                            {
                                <div class="artist-albums-loading">@Loc["search.loadingAlbums"]</div>
                            }
                            else if (State.ArtistAlbums != null && State.ArtistAlbums.Count > 0)
                            {
                                <div class="artist-albums-toolbar">
                                    <select class="sort-select" @bind="State.ArtistAlbumSort">
                                        <option value="@SearchSort.Relevance">@Loc["sort.relevance"]</option>
                                        <option value="@SearchSort.DateAsc">@Loc["sort.dateAsc"]</option>
                                        <option value="@SearchSort.DateDesc">@Loc["sort.dateDesc"]</option>
                                        <option value="@SearchSort.TitleAsc">@Loc["sort.titleAsc"]</option>
                                        <option value="@SearchSort.TitleDesc">@Loc["sort.titleDesc"]</option>
                                        <option value="@SearchSort.QualityDesc">@Loc["sort.qualityDesc"]</option>
                                        <option value="@SearchSort.CountDesc">@Loc["sort.tracksDesc"]</option>
                                        <option value="@SearchSort.CountAsc">@Loc["sort.tracksAsc"]</option>
                                        <option value="@SearchSort.LabelAsc">@Loc["sort.labelAsc"]</option>
                                    </select>
                                </div>
                                @foreach (var album in SearchSorter.SortAlbums(State.ArtistAlbums, State.ArtistAlbumSort))
                                {
                                    var aId = album.Id;
                                    var aUrl = AlbumUrl(aId);
                                    <div class="search-result-row artist-album-row @(_selectedAlbums.Contains(aId) ? "selected" : "")">
                                        <input type="checkbox" class="select-checkbox" checked="@_selectedAlbums.Contains(aId)" @onchange="() => ToggleAlbum(aId)" />
                                        <img src="@album.Image?.Thumbnail" alt="" />
                                        <div class="search-result-info">
                                            <div class="title">@album.Title @(album.Version != null ? $"({album.Version})" : "")</div>
                                            <div class="artist">@album.ReleaseDateOriginal &middot; @Loc.P("search.trackCount", album.TracksCount) &middot; @(album.MaximumBitDepth)bit/@(album.MaximumSamplingRate)kHz</div>
                                        </div>
                                        @if (Download.IsDone(aUrl))
                                        {
                                            <span class="queue-done-mark" title='@Loc["queue.doneMark"]'>&#10003;</span>
                                        }
                                        <button class="btn btn-primary btn-sm" @onclick="() => QueueAlbum(album)" disabled="@Download.IsQueued(aUrl)" title='@Loc["search.download"]'><span class="btn-label">@Loc["search.download"]</span></button>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="artist-albums-loading">@Loc["search.noAlbums"]</div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@if (TotalSelected > 0)
{
    <div class="selection-bar">
        <span>@Loc.P("search.selected", TotalSelected)</span>
        <button class="btn btn-primary btn-sm" @onclick="DownloadSelected">@Loc["search.downloadSelection"]</button>
        <button class="btn btn-secondary btn-sm" @onclick="ClearSelection">@Loc["search.clearSelection"]</button>
    </div>
}

@* @key incrémental : l'animation CSS ne se déclenche qu'à la création du nœud. Sans lui, Blazor
   réutiliserait le même <div> pour un second toast et celui-ci apparaîtrait déjà effacé. *@
@if (_toast != null)
{
    <div class="toast-notification @(_toastIsError ? "error" : "")" @key="_toastSeq">@_toast</div>
}

@code {
    private bool _searching;
    private bool _searchFailed;
    private bool _loadingArtistAlbums;
    private HashSet<string> _selectedAlbums = new();
    private HashSet<int> _selectedTracks = new();
    private int TotalSelected => _selectedAlbums.Count + _selectedTracks.Count;

    // La recherche a abouti mais n'a rien trouvé : distinct d'un échec, où les listes sont nulles.
    private bool HasNoResults => !_searching && State.LastSearchType switch
    {
        "albums" => State.Albums is { Count: 0 },
        "tracks" => State.Tracks is { Count: 0 },
        "artists" => State.Artists is { Count: 0 },
        _ => false
    };

    private string? _toast;
    private bool _toastIsError;
    private int _toastSeq;
    private int _toastGen;

    // Cette page est désormais la page d'accueil ("/"), elle doit donc porter le garde de session
    // qui vivait jusqu'ici uniquement sur le téléchargeur.
    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (!Api.IsLoggedIn) { Nav.NavigateTo("/login"); return; }

        // OnQueueChanged uniquement : sans cet abonnement, ni le grisage ni la marque ✓ ne se
        // rafraîchiraient quand un élément se termine. S'abonner en plus à OnProgressChanged
        // redessinerait cette page à chaque bloc téléchargé, pour rien.
        Download.OnQueueChanged += OnQueueChanged;
    }

    private void OnQueueChanged() => InvokeAsync(StateHasChanged);

    public override void Dispose()
    {
        base.Dispose();
        Download.OnQueueChanged -= OnQueueChanged;
    }

    private async Task DoSearch(string type)
    {
        // _searching protège aussi la touche Entrée, que le bouton désactivé ne couvre pas.
        if (string.IsNullOrWhiteSpace(State.Query) || _searching) return;
        _searching = true;
        _searchFailed = false;
        State.LastSearchType = type;
        State.Albums = null;
        State.Tracks = null;
        State.Artists = null;
        State.ExpandedArtistId = 0;
        State.ArtistAlbums = null;

        try
        {
            switch (type)
            {
                case "albums":
                    var albumResult = await Api.SearchAlbumsAsync(State.Query, 50);
                    State.Albums = albumResult?.Albums?.Items ?? new();
                    break;
                case "tracks":
                    var trackResult = await Api.SearchTracksAsync(State.Query, 50);
                    State.Tracks = trackResult?.Tracks?.Items ?? new();
                    break;
                case "artists":
                    var artistResult = await Api.SearchArtistsAsync(State.Query, 50);
                    State.Artists = artistResult?.Artists?.Items ?? new();
                    break;
            }
        }
        catch (QobuzApiException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            // Jeton révoqué ou expiré : inutile de laisser l'interface croire à une session valide.
            Logger.LogInformation("Qobuz rejected the session during a search, signing out");
            Settings.ClearQobuzSession();
            Api.SetCredentials("", "", "");
            Nav.NavigateTo("/login?expired=1", forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Search failed for type {Type}", type);
            _searchFailed = true;
            State.Albums = null;
            State.Tracks = null;
            State.Artists = null;
        }
        finally
        {
            _searching = false;
        }
    }

    private async Task ToggleArtist(int artistId)
    {
        if (State.ExpandedArtistId == artistId)
        {
            State.ExpandedArtistId = 0;
            State.ArtistAlbums = null;
            return;
        }

        State.ExpandedArtistId = artistId;
        State.ArtistAlbums = null;
        _loadingArtistAlbums = true;
        StateHasChanged();

        try
        {
            var artist = await Api.GetArtistFullAsync(artistId.ToString());
            State.ArtistAlbums = artist.Albums?.Items ?? new();
        }
        catch
        {
            State.ArtistAlbums = new();
        }
        finally
        {
            _loadingArtistAlbums = false;
        }
    }

    // ─── File d'attente ───
    //
    // Ces trois méthodes sont synchrones : Enqueue rend la main immédiatement, le worker du service
    // draine en arrière-plan. C'est ce qui permet de continuer à chercher pendant un téléchargement,
    // là où l'ancien `await ProcessUrlAsync` bloquait le gestionnaire de clic jusqu'au bout.
    // La variable d'itération d'un foreach étant capturée par itération depuis C# 5,
    // `@onclick="() => QueueAlbum(album)"` désigne bien l'album de la ligne.

    private static string AlbumUrl(string id) => $"https://play.qobuz.com/album/{id}";
    private static string TrackUrl(int id) => $"https://play.qobuz.com/track/{id}";
    private static string ArtistUrl(int id) => $"https://play.qobuz.com/artist/{id}";

    private static QueueRequest AlbumRequest(QobuzAlbum a) => new(
        AlbumUrl(a.Id),
        a.Title + (a.Version != null ? $" ({a.Version})" : ""),
        a.Artist?.Name,
        a.Image?.Thumbnail);

    private static QueueRequest TrackRequest(QobuzTrack t) => new(
        TrackUrl(t.Id),
        t.Title + (t.Version != null ? $" ({t.Version})" : ""),
        t.Performer?.Name,
        t.Album?.Image?.Thumbnail);

    private void QueueAlbum(QobuzAlbum album) => ToastFor(Enqueue(AlbumRequest(album)));

    private void QueueTrack(QobuzTrack track) => ToastFor(Enqueue(TrackRequest(track)));

    private void QueueArtist(QobuzArtist artist) => ToastFor(Download.Enqueue(
        ArtistUrl(artist.Id), artist.Name, null, artist.Picture));

    private EnqueueResult Enqueue(QueueRequest r) =>
        Download.Enqueue(r.Url, r.Label, r.SubLabel, r.Thumbnail);

    private void ToastFor(EnqueueResult result)
    {
        var (msg, isError) = result switch
        {
            EnqueueResult.Added => (Loc.P("queue.added", 1), false),
            EnqueueResult.Requeued => (Loc["queue.requeued"], false),
            EnqueueResult.AlreadyQueued => (Loc["queue.alreadyQueued"], false),
            _ => (Loc["queue.invalidUrl"], true)
        };
        ShowToast(msg, isError);
    }

    private void ShowToast(string message, bool isError = false)
    {
        _toast = message;
        _toastIsError = isError;
        _toastSeq++;

        // Compteur de génération : un toast plus récent neutralise le Task.Delay du précédent, qui
        // sinon effacerait le message affiché avant l'heure.
        var gen = ++_toastGen;
        _ = HideToastLater(gen);
    }

    private async Task HideToastLater(int gen)
    {
        await Task.Delay(1600);   // l'animation toastOut se termine à 1,5 s
        if (gen != _toastGen) return;
        _toast = null;
        // L'utilisateur a pu quitter la page entre-temps : le circuit est alors fermé et il n'y a
        // plus rien à redessiner.
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    private void ToggleAlbum(string id)
    {
        if (!_selectedAlbums.Remove(id)) _selectedAlbums.Add(id);
    }

    private void ToggleTrack(int id)
    {
        if (!_selectedTracks.Remove(id)) _selectedTracks.Add(id);
    }

    private void ToggleSelectAllAlbums()
    {
        if (State.Albums == null) return;
        if (_selectedAlbums.Count == State.Albums.Count)
            _selectedAlbums.Clear();
        else
            _selectedAlbums = new(State.Albums.Select(a => a.Id));
    }

    private void ToggleSelectAllTracks()
    {
        if (State.Tracks == null) return;
        if (_selectedTracks.Count == State.Tracks.Count)
            _selectedTracks.Clear();
        else
            _selectedTracks = new(State.Tracks.Select(t => t.Id));
    }

    private void ClearSelection()
    {
        _selectedAlbums.Clear();
        _selectedTracks.Clear();
    }

    private void DownloadSelected()
    {
        // Order the batch like the lists are displayed on screen rather than by the arbitrary
        // order of the selection HashSets. Anything selected in a previous search (no longer in
        // the visible lists) is still appended at the end, so nothing is silently dropped.
        var albumIds = new List<string>();
        var seenAlbums = new HashSet<string>();

        void AddAlbums(IEnumerable<string> ids)
        {
            foreach (var id in ids)
                if (_selectedAlbums.Contains(id) && seenAlbums.Add(id))
                    albumIds.Add(id);
        }

        if (State.Albums != null)
            AddAlbums(SearchSorter.SortAlbums(State.Albums, State.AlbumSort).Select(a => a.Id));
        if (State.ArtistAlbums != null)
            AddAlbums(SearchSorter.SortAlbums(State.ArtistAlbums, State.ArtistAlbumSort).Select(a => a.Id));
        AddAlbums(_selectedAlbums);

        var trackIds = new List<int>();
        if (State.Tracks != null)
            trackIds.AddRange(SearchSorter.SortTracks(State.Tracks, State.TrackSort)
                .Select(t => t.Id).Where(_selectedTracks.Contains));
        var seenTracks = trackIds.ToHashSet();
        trackIds.AddRange(_selectedTracks.Where(id => !seenTracks.Contains(id)));

        // Retrouver les objets pour alimenter libellé, artiste et vignette de la file. Un identifiant
        // sélectionné lors d'une recherche précédente n'est plus dans les listes visibles : on
        // l'enfile alors sur sa seule URL, plutôt que de le perdre en route.
        var albumById = new Dictionary<string, QobuzAlbum>();
        foreach (var a in (State.Albums ?? new()).Concat(State.ArtistAlbums ?? new()))
            albumById[a.Id] = a;

        var trackById = new Dictionary<int, QobuzTrack>();
        foreach (var t in State.Tracks ?? new())
            trackById[t.Id] = t;

        var requests = new List<QueueRequest>();
        foreach (var id in albumIds)
            requests.Add(albumById.TryGetValue(id, out var a)
                ? AlbumRequest(a)
                : new QueueRequest(AlbumUrl(id)));
        foreach (var id in trackIds)
            requests.Add(trackById.TryGetValue(id, out var t)
                ? TrackRequest(t)
                : new QueueRequest(TrackUrl(id)));

        ClearSelection();

        var (added, requeued, duplicates, invalid) = Download.EnqueueMany(requests);
        var queued = added + requeued;
        if (queued > 0) ShowToast(Loc.P("queue.added", queued));
        else if (duplicates > 0) ShowToast(Loc["queue.alreadyQueued"]);
        else if (invalid > 0) ShowToast(Loc["queue.invalidUrl"], isError: true);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoSearch(State.LastSearchType);
    }
}
