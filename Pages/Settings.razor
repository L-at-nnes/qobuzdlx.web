@page "/settings"
@inject SettingsService SettingsSvc
@inject IJSRuntime JS
@inherits LocalizedComponentBase

<h3 style="margin-bottom:16px;">@Loc["settings.title"]</h3>

<!-- Download Folder -->
<div class="card">
    <div class="card-title">@Loc["settings.folder.title"]</div>
    <div class="form-group">
        <label>@Loc["settings.folder.location"]</label>
        <input type="text" @bind="S.DownloadLocation" @bind:after="Save" />
    </div>
</div>

<!-- Quality -->
<div class="card">
    <div class="card-title">@Loc["settings.quality.title"]</div>
    <div class="quality-group">
        <button class="quality-btn @(S.QualityFormat == "5" ? "active" : "")" @onclick='() => SetQuality("5", ".mp3")'>MP3 320</button>
        <button class="quality-btn @(S.QualityFormat == "6" ? "active" : "")" @onclick='() => SetQuality("6", ".flac")'>FLAC 16bit</button>
        <button class="quality-btn @(S.QualityFormat == "7" ? "active" : "")" @onclick='() => SetQuality("7", ".flac")'>FLAC 24bit &le;96kHz</button>
        <button class="quality-btn @(S.QualityFormat == "27" ? "active" : "")" @onclick='() => SetQuality("27", ".flac")'>FLAC 24bit 192kHz</button>
    </div>
    <div style="font-size:0.8em;color:var(--text-secondary);margin-top:8px;">
        @Loc["settings.quality.hint"]
    </div>
</div>

<!-- Templates -->
<div class="card">
    <div class="card-title">@Loc["settings.templates.title"]</div>
    <div class="settings-grid">
        <div class="form-group">
            <label>@Loc["settings.templates.artist"]</label>
            <input type="text" @bind="S.ArtistTemplate" @bind:after="Save" />
        </div>
        <div class="form-group">
            <label>@Loc["settings.templates.album"]</label>
            <input type="text" @bind="S.AlbumTemplate" @bind:after="Save" />
        </div>
        <div class="form-group">
            <label>@Loc["settings.templates.track"]</label>
            <input type="text" @bind="S.TrackTemplate" @bind:after="Save" />
        </div>
        <div class="form-group">
            <label>@Loc["settings.templates.vaTrack"]</label>
            <input type="text" @bind="S.VaTrackTemplate" @bind:after="Save" />
        </div>
        <div class="form-group">
            <label>@Loc["settings.templates.playlist"]</label>
            <input type="text" @bind="S.PlaylistTemplate" @bind:after="Save" />
        </div>
        <div class="form-group">
            <label>@Loc["settings.templates.favorites"]</label>
            <input type="text" @bind="S.FavoritesTemplate" @bind:after="Save" />
        </div>
        <div class="form-group">
            <label>@Loc["settings.templates.cd"]</label>
            <input type="text" @bind="S.CdTemplate" @bind:after="Save" />
        </div>
    </div>

    <!-- Template Variables Reference -->
    <details class="template-help" style="margin-top:16px;">
        <summary class="template-help-toggle">@Loc["settings.templates.varsToggle"]</summary>
        <div class="template-help-content">

            <div class="template-section">
                <div class="template-section-title">@Loc["settings.templates.section.release"]</div>
                <div class="template-tokens">
                    <span class="token" @onclick='() => CopyToken("%AlbumID%")'>%AlbumID%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumURL%")'>%AlbumURL%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumGenre%")'>%AlbumGenre%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumComposer%")'>%AlbumComposer%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumTitle%")'>%AlbumTitle%</span>
                    <span class="token" @onclick='() => CopyToken("%Label%")'>%Label%</span>
                    <span class="token" @onclick='() => CopyToken("%Copyright%")'>%Copyright%</span>
                    <span class="token" @onclick='() => CopyToken("%UPC%")'>%UPC%</span>
                    <span class="token" @onclick='() => CopyToken("%ReleaseDate%")'>%ReleaseDate%</span>
                    <span class="token" @onclick='() => CopyToken("%Year%")'>%Year%</span>
                    <span class="token" @onclick='() => CopyToken("%ReleaseType%")'>%ReleaseType%</span>
                    <span class="token" @onclick='() => CopyToken("%ArtistName%")'>%ArtistName%</span>
                    <span class="token" @onclick='() => CopyToken("%Format%")'>%Format%</span>
                    <span class="token" @onclick='() => CopyToken("%FormatWithQuality%")'>%FormatWithQuality%</span>
                    <span class="token" @onclick='() => CopyToken("%FormatWithHiResQuality%")'>%FormatWithHiResQuality%</span>
                    <span class="token" @onclick='() => CopyToken("%BitDepth%")'>%BitDepth%</span>
                    <span class="token" @onclick='() => CopyToken("%SampleRate%")'>%SampleRate%</span>
                </div>
            </div>

            <details class="template-subsection">
                <summary>@Loc["settings.templates.section.parentalRelease"]</summary>
                <div class="template-tokens">
                    <span class="token" @onclick='() => CopyToken("%AlbumPA%")'>%AlbumPA%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAShort%")'>%AlbumPAShort%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifEx%")'>%AlbumPAifEx%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifExShort%")'>%AlbumPAifExShort%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifCl%")'>%AlbumPAifCl%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifClShort%")'>%AlbumPAifClShort%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAEnclosed%")'>%AlbumPAEnclosed%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAEnclosed[]%")'>%AlbumPAEnclosed[]%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAEnclosedShort%")'>%AlbumPAEnclosedShort%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAEnclosedShort[]%")'>%AlbumPAEnclosedShort[]%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifExEnclosed%")'>%AlbumPAifExEnclosed%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifExEnclosed[]%")'>%AlbumPAifExEnclosed[]%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifExEnclosedShort%")'>%AlbumPAifExEnclosedShort%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifExEnclosedShort[]%")'>%AlbumPAifExEnclosedShort[]%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifClEnclosed%")'>%AlbumPAifClEnclosed%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifClEnclosed[]%")'>%AlbumPAifClEnclosed[]%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifClEnclosedShort%")'>%AlbumPAifClEnclosedShort%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifClEnclosedShort[]%")'>%AlbumPAifClEnclosedShort[]%</span>
                </div>
            </details>

            <div class="template-section">
                <div class="template-section-title">@Loc["settings.templates.section.track"]</div>
                <div class="template-tokens">
                    <span class="token" @onclick='() => CopyToken("%TrackArtist%")'>%TrackArtist%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackComposer%")'>%TrackComposer%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackID%")'>%TrackID%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackNumber%")'>%TrackNumber%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackTitle%")'>%TrackTitle%</span>
                    <span class="token" @onclick='() => CopyToken("%ISRC%")'>%ISRC%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackFormat%")'>%TrackFormat%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackFormatWithQuality%")'>%TrackFormatWithQuality%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackFormatWithHiResQuality%")'>%TrackFormatWithHiResQuality%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackBitDepth%")'>%TrackBitDepth%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackSampleRate%")'>%TrackSampleRate%</span>
                </div>
            </div>

            <details class="template-subsection">
                <summary>@Loc["settings.templates.section.parentalTrack"]</summary>
                <div class="template-tokens">
                    <span class="token" @onclick='() => CopyToken("%TrackPA%")'>%TrackPA%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAShort%")'>%TrackPAShort%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifEx%")'>%TrackPAifEx%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifExShort%")'>%TrackPAifExShort%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifCl%")'>%TrackPAifCl%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifClShort%")'>%TrackPAifClShort%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAEnclosed%")'>%TrackPAEnclosed%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAEnclosed[]%")'>%TrackPAEnclosed[]%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAEnclosedShort%")'>%TrackPAEnclosedShort%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAEnclosedShort[]%")'>%TrackPAEnclosedShort[]%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifExEnclosed%")'>%TrackPAifExEnclosed%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifExEnclosed[]%")'>%TrackPAifExEnclosed[]%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifExEnclosedShort%")'>%TrackPAifExEnclosedShort%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifExEnclosedShort[]%")'>%TrackPAifExEnclosedShort[]%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifClEnclosed%")'>%TrackPAifClEnclosed%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifClEnclosed[]%")'>%TrackPAifClEnclosed[]%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifClEnclosedShort%")'>%TrackPAifClEnclosedShort%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifClEnclosedShort[]%")'>%TrackPAifClEnclosedShort[]%</span>
                </div>
            </details>

            <div class="template-section">
                <div class="template-section-title">@Loc["settings.templates.section.playlist"]</div>
                <div class="template-tokens">
                    <span class="token" @onclick='() => CopyToken("%PlaylistID%")'>%PlaylistID%</span>
                    <span class="token" @onclick='() => CopyToken("%PlaylistTitle%")'>%PlaylistTitle%</span>
                    <span class="token" @onclick='() => CopyToken("%Format%")'>%Format%</span>
                    <span class="token" @onclick='() => CopyToken("%FormatWithQuality%")'>%FormatWithQuality%</span>
                    <span class="token" @onclick='() => CopyToken("%FormatWithHiResQuality%")'>%FormatWithHiResQuality%</span>
                </div>
            </div>

            <div class="template-section">
                <div class="template-section-title">@Loc["settings.templates.section.cd"]</div>
                <div class="template-tokens">
                    <span class="token" @onclick='() => CopyToken("%DiscNumber%")'>%DiscNumber%</span>
                </div>
            </div>

            <div class="template-hint">@Loc["settings.templates.hint"]</div>
        </div>
    </details>
</div>

<!-- Tagging Options -->
<div class="card">
    <div class="card-title">@Loc["settings.tagging.title"]</div>
    <div class="settings-grid">
        <div class="setting-item"><input type="checkbox" @bind="S.AlbumTag" @bind:after="Save" /><label>@Loc["settings.tag.album"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.AlbumArtistTag" @bind:after="Save" /><label>@Loc["settings.tag.albumArtist"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.ArtistTag" @bind:after="Save" /><label>@Loc["settings.tag.artist"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.TrackTitleTag" @bind:after="Save" /><label>@Loc["settings.tag.trackTitle"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.TrackTag" @bind:after="Save" /><label>@Loc["settings.tag.trackNumber"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.TotalTracksTag" @bind:after="Save" /><label>@Loc["settings.tag.totalTracks"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.DiscTag" @bind:after="Save" /><label>@Loc["settings.tag.disc"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.TotalDiscsTag" @bind:after="Save" /><label>@Loc["settings.tag.totalDiscs"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.GenreTag" @bind:after="Save" /><label>@Loc["settings.tag.genre"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.YearTag" @bind:after="Save" /><label>@Loc["settings.tag.year"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.ReleaseDateTag" @bind:after="Save" /><label>@Loc["settings.tag.releaseDate"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.ComposerTag" @bind:after="Save" /><label>@Loc["settings.tag.composer"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.CopyrightTag" @bind:after="Save" /><label>@Loc["settings.tag.copyright"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.LabelTag" @bind:after="Save" /><label>@Loc["settings.tag.label"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.IsrcTag" @bind:after="Save" /><label>@Loc["settings.tag.isrc"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.UpcTag" @bind:after="Save" /><label>@Loc["settings.tag.upc"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.TypeTag" @bind:after="Save" /><label>@Loc["settings.tag.type"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.ExplicitTag" @bind:after="Save" /><label>@Loc["settings.tag.explicit"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.ImageTag" @bind:after="Save" /><label>@Loc["settings.tag.artwork"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.UrlTag" @bind:after="Save" /><label>@Loc["settings.tag.url"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.MergeArtistNames" @bind:after="Save" /><label>@Loc["settings.tag.mergeArtists"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.MergeArtistNamesInDirNames" @bind:after="Save" /><label>@Loc["settings.tag.mergeArtistsDirs"]</label></div>
    </div>

    <div style="margin-top:12px;">
        <div class="setting-item"><input type="checkbox" @bind="S.CommentTag" @bind:after="Save" /><label>@Loc["settings.tag.comment"]</label></div>
        @if (S.CommentTag)
        {
            <div class="form-group" style="margin-top:8px;">
                <input type="text" @bind="S.CommentText" @bind:after="Save" placeholder='@Loc["settings.tag.commentPlaceholder"]' />
            </div>
        }
    </div>

    <div style="margin-top:12px;">
        <div class="setting-item"><input type="checkbox" @bind="S.ExplicitTagInTitle" @bind:after="Save" /><label>@Loc["settings.tag.explicitInTitle"]</label></div>
        @if (S.ExplicitTagInTitle)
        {
            <div class="field-row title-tag-row">
                <div class="form-group">
                    <label>@Loc["settings.tag.titleText"]</label>
                    <input type="text" @bind="S.ExplicitTitleTagText" @bind:after="Save" />
                </div>
                <div class="form-group">
                    <label>@Loc["settings.tag.titlePosition"]</label>
                    <select @bind="S.ExplicitTitleTagPrefixOrSuffix" @bind:after="Save">
                        <option value="0">@Loc["settings.tag.position.prefix"]</option>
                        <option value="1">@Loc["settings.tag.position.suffix"]</option>
                    </select>
                </div>
                <div class="title-tag-example">@Loc.T("settings.tag.titleExample", TaggingService.ApplyTitleTag("Song", S.ExplicitTitleTagText, S.ExplicitTitleTagPrefixOrSuffix))</div>
            </div>
        }
        <div class="setting-item"><input type="checkbox" @bind="S.CleanTagInTitle" @bind:after="Save" /><label>@Loc["settings.tag.cleanInTitle"]</label></div>
        @if (S.CleanTagInTitle)
        {
            <div class="field-row title-tag-row">
                <div class="form-group">
                    <label>@Loc["settings.tag.titleText"]</label>
                    <input type="text" @bind="S.CleanTitleTagText" @bind:after="Save" />
                </div>
                <div class="form-group">
                    <label>@Loc["settings.tag.titlePosition"]</label>
                    <select @bind="S.CleanTitleTagPrefixOrSuffix" @bind:after="Save">
                        <option value="0">@Loc["settings.tag.position.prefix"]</option>
                        <option value="1">@Loc["settings.tag.position.suffix"]</option>
                    </select>
                </div>
                <div class="title-tag-example">@Loc.T("settings.tag.titleExample", TaggingService.ApplyTitleTag("Song", S.CleanTitleTagText, S.CleanTitleTagPrefixOrSuffix))</div>
            </div>
        }
        <div class="template-hint">@Loc["settings.tag.titleHint"]</div>
    </div>
</div>

<!-- Artwork -->
<div class="card">
    <div class="card-title">@Loc["settings.artwork.title"]</div>
    <div class="settings-grid">
        <div class="form-group">
            <label>@Loc["settings.artwork.embedded"]</label>
            <select @bind="S.EmbeddedArtSize" @bind:after="Save">
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="150">150</option>
                <option value="230">230</option>
                <option value="300">300</option>
                <option value="600">600</option>
                <option value="org">@Loc["settings.artwork.originalEmbedded"]</option>
            </select>
        </div>
        <div class="form-group">
            <label>@Loc["settings.artwork.saved"]</label>
            <select @bind="S.SavedArtSize" @bind:after="Save">
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="150">150</option>
                <option value="230">230</option>
                <option value="300">300</option>
                <option value="600">600</option>
                <option value="org">@Loc["settings.artwork.original"]</option>
            </select>
        </div>
    </div>
    <div class="setting-item"><input type="checkbox" @bind="S.DontSaveArtworkToDisk" @bind:after="Save" /><label>@Loc["settings.artwork.dontSave"]</label></div>
</div>

<!-- Advanced -->
<div class="card">
    <div class="card-title">@Loc["settings.advanced.title"]</div>
    <div class="settings-grid">
        <div class="setting-item"><input type="checkbox" @bind="S.StreamableCheck" @bind:after="Save" /><label>@Loc["settings.advanced.streamable"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.FixMD5s" @bind:after="Save" /><label>@Loc["settings.advanced.fixMd5"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.VerifyIntegrity" @bind:after="Save" /><label>@Loc["settings.advanced.verifyIntegrity"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.DownloadGoodies" @bind:after="Save" /><label>@Loc["settings.advanced.goodies"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.DownloadSpeed" @bind:after="Save" /><label>@Loc["settings.advanced.speed"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.UseItemPosInPlaylist" @bind:after="Save" /><label>@Loc["settings.advanced.playlistPos"]</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.LogFailedDownloads" @bind:after="Save" /><label>@Loc["settings.advanced.logFailed"]</label></div>
    </div>

    <div class="form-group" style="margin-top:12px;">
        <label>@Loc["settings.duplicates.label"]</label>
        <select @bind="S.DuplicateFileMode" @bind:after="Save">
            <option value="skip">@Loc["settings.duplicates.skip"]</option>
            <option value="rename">@Loc["settings.duplicates.rename"]</option>
            <option value="overwrite">@Loc["settings.duplicates.overwrite"]</option>
        </select>
    </div>
</div>

<!-- App Access Password -->
<div class="card">
    <div class="card-title">@Loc["settings.access.title"]</div>
    <p style="font-size:0.85em;color:var(--text-secondary);margin-bottom:12px;">
        @Loc["settings.access.description"]
    </p>

    @if (string.IsNullOrEmpty(S.AppAccessPasswordHash))
    {
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
            <span style="color:var(--text-secondary);font-size:0.85em;">@Loc["settings.access.status"]</span>
            <span style="color:var(--text-secondary);font-size:0.85em;">@Loc["settings.access.none"]</span>
        </div>
        <div class="field-row">
            <div class="form-group">
                <label>@Loc["settings.access.newPassword"]</label>
                <input type="password" @bind="_newAccessPassword" placeholder='@Loc["settings.access.choosePlaceholder"]' />
            </div>
            <div class="form-group">
                <label>@Loc["settings.access.confirmPassword"]</label>
                <input type="password" @bind="_confirmAccessPassword" placeholder='@Loc["settings.access.confirmPlaceholder"]' />
            </div>
            <button class="btn btn-primary" @onclick="SetAccessPassword" disabled="@string.IsNullOrWhiteSpace(_newAccessPassword)">@Loc["settings.access.enable"]</button>
        </div>
    }
    else
    {
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
            <span style="color:var(--text-secondary);font-size:0.85em;">@Loc["settings.access.status"]</span>
            <span style="color:var(--success);font-size:0.85em;">@Loc["settings.access.active"]</span>
        </div>
        <div class="field-row">
            <div class="form-group">
                <label>@Loc["settings.access.newPassword"]</label>
                <input type="password" @bind="_newAccessPassword" placeholder='@Loc["settings.access.changePlaceholder"]' />
            </div>
            <div class="form-group">
                <label>@Loc["settings.access.confirmPassword"]</label>
                <input type="password" @bind="_confirmAccessPassword" placeholder='@Loc["settings.access.confirmPlaceholder"]' />
            </div>
            <button class="btn btn-primary" @onclick="SetAccessPassword" disabled="@string.IsNullOrWhiteSpace(_newAccessPassword)">@Loc["settings.access.change"]</button>
            <button class="btn btn-danger" @onclick="RemoveAccessPassword">@Loc["settings.access.remove"]</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_accessPasswordError))
    {
        <div style="color:#e74c3c;font-size:0.85em;margin-top:8px;">@_accessPasswordError</div>
    }

    @if (_accessPasswordSaved)
    {
        <div style="color:var(--success);font-size:0.85em;margin-top:8px;">@_accessPasswordMessage</div>
    }
</div>

@if (_showCopied)
{
    <div class="toast-notification">@Loc.T("settings.copied", _copiedToken)</div>
}

@code {
    private Models.AppSettings S => SettingsSvc.Settings;
    private bool _showCopied;
    private string _copiedToken = "";
    private string _newAccessPassword = "";
    private string _confirmAccessPassword = "";
    private string _accessPasswordError = "";
    private bool _accessPasswordSaved;
    private string _accessPasswordMessage = "";

    private void Save() => SettingsSvc.Save();

    // Format Qobuz (5 = MP3 320, 6 = FLAC 16bit, 7 = FLAC 24bit <=96kHz, 27 = FLAC 24bit 192kHz)
    // et extension du fichier produit, enregistrés ensemble pour rester cohérents.
    private void SetQuality(string formatId, string audioFormat)
    {
        SettingsSvc.Update(s => { s.QualityFormat = formatId; s.AudioFormat = audioFormat; });
    }

    private async Task SetAccessPassword()
    {
        if (string.IsNullOrWhiteSpace(_newAccessPassword)) return;

        _accessPasswordError = "";
        if (_newAccessPassword.Length < AppGuardService.MinPasswordLength)
            _accessPasswordError = Loc.T("settings.access.tooShort", AppGuardService.MinPasswordLength);
        else if (_newAccessPassword != _confirmAccessPassword)
            _accessPasswordError = Loc["settings.access.mismatch"];
        if (_accessPasswordError.Length > 0) return;

        SettingsSvc.Update(s => s.AppAccessPasswordHash = AppGuardService.HashPassword(_newAccessPassword));
        _newAccessPassword = "";
        _confirmAccessPassword = "";
        _accessPasswordMessage = Loc["settings.access.saved"];
        _accessPasswordSaved = true;
        StateHasChanged();
        await Task.Delay(3000);
        _accessPasswordSaved = false;
        StateHasChanged();
    }

    private async Task RemoveAccessPassword()
    {
        SettingsSvc.Update(s => s.AppAccessPasswordHash = "");
        _newAccessPassword = "";
        _confirmAccessPassword = "";
        _accessPasswordError = "";
        _accessPasswordMessage = Loc["settings.access.removed"];
        _accessPasswordSaved = true;
        StateHasChanged();
        await Task.Delay(3000);
        _accessPasswordSaved = false;
        StateHasChanged();
    }

    private async Task CopyToken(string token)
    {
        try
        {
            await JS.InvokeVoidAsync("copyToClipboard", token);
        }
        catch { }

        _copiedToken = token;
        _showCopied = true;
        StateHasChanged();

        await Task.Delay(1500);
        _showCopied = false;
        StateHasChanged();
    }
}
