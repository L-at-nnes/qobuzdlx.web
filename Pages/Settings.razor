@page "/settings"
@inject SettingsService SettingsSvc
@inject IJSRuntime JS

<h3 style="margin-bottom:16px;">Paramètres</h3>

<!-- Download Folder -->
<div class="card">
    <div class="card-title">Dossier de téléchargement</div>
    <div class="form-group">
        <label>Emplacement (volume Docker)</label>
        <input type="text" @bind="S.DownloadLocation" @bind:after="Save" />
    </div>
</div>

<!-- Templates -->
<div class="card">
    <div class="card-title">Modèles</div>
    <div class="settings-grid">
        <div class="form-group">
            <label>Modèle Artiste</label>
            <input type="text" @bind="S.ArtistTemplate" @bind:after="Save" />
        </div>
        <div class="form-group">
            <label>Modèle Album</label>
            <input type="text" @bind="S.AlbumTemplate" @bind:after="Save" />
        </div>
        <div class="form-group">
            <label>Modèle Piste (par défaut)</label>
            <input type="text" @bind="S.TrackTemplate" @bind:after="Save" />
        </div>
        <div class="form-group">
            <label>Modèle Piste (V/A)</label>
            <input type="text" @bind="S.VaTrackTemplate" @bind:after="Save" />
        </div>
        <div class="form-group">
            <label>Modèle Playlist</label>
            <input type="text" @bind="S.PlaylistTemplate" @bind:after="Save" />
        </div>
        <div class="form-group">
            <label>Modèle Favoris</label>
            <input type="text" @bind="S.FavoritesTemplate" @bind:after="Save" />
        </div>
        <div class="form-group">
            <label>Modèle CD</label>
            <input type="text" @bind="S.CdTemplate" @bind:after="Save" />
        </div>
    </div>

    <!-- Template Variables Reference -->
    <details class="template-help" style="margin-top:16px;">
        <summary class="template-help-toggle">Variables de modèle disponibles</summary>
        <div class="template-help-content">

            <div class="template-section">
                <div class="template-section-title">Spécifique à la sortie</div>
                <div class="template-tokens">
                    <span class="token" @onclick='() => CopyToken("%AlbumID%")'>%AlbumID%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumURL%")'>%AlbumURL%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumGenre%")'>%AlbumGenre%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumComposer%")'>%AlbumComposer%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumTitle%")'>%AlbumTitle%</span>
                    <span class="token" @onclick='() => CopyToken("%Label%")'>%Label%</span>
                    <span class="token" @onclick='() => CopyToken("%Copyright%")'>%Copyright%</span>
                    <span class="token" @onclick='() => CopyToken("%UPC%")'>%UPC%</span>
                    <span class="token" @onclick='() => CopyToken("%ReleaseDate%")'>%ReleaseDate%</span>
                    <span class="token" @onclick='() => CopyToken("%Year%")'>%Year%</span>
                    <span class="token" @onclick='() => CopyToken("%ReleaseType%")'>%ReleaseType%</span>
                    <span class="token" @onclick='() => CopyToken("%ArtistName%")'>%ArtistName%</span>
                    <span class="token" @onclick='() => CopyToken("%Format%")'>%Format%</span>
                    <span class="token" @onclick='() => CopyToken("%FormatWithQuality%")'>%FormatWithQuality%</span>
                    <span class="token" @onclick='() => CopyToken("%FormatWithHiResQuality%")'>%FormatWithHiResQuality%</span>
                    <span class="token" @onclick='() => CopyToken("%BitDepth%")'>%BitDepth%</span>
                    <span class="token" @onclick='() => CopyToken("%SampleRate%")'>%SampleRate%</span>
                </div>
            </div>

            <details class="template-subsection">
                <summary>Contrôle parental (sortie)</summary>
                <div class="template-tokens">
                    <span class="token" @onclick='() => CopyToken("%AlbumPA%")'>%AlbumPA%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAShort%")'>%AlbumPAShort%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifEx%")'>%AlbumPAifEx%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifExShort%")'>%AlbumPAifExShort%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifCl%")'>%AlbumPAifCl%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifClShort%")'>%AlbumPAifClShort%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAEnclosed%")'>%AlbumPAEnclosed%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAEnclosed[]%")'>%AlbumPAEnclosed[]%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAEnclosedShort%")'>%AlbumPAEnclosedShort%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAEnclosedShort[]%")'>%AlbumPAEnclosedShort[]%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifExEnclosed%")'>%AlbumPAifExEnclosed%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifExEnclosed[]%")'>%AlbumPAifExEnclosed[]%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifExEnclosedShort%")'>%AlbumPAifExEnclosedShort%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifExEnclosedShort[]%")'>%AlbumPAifExEnclosedShort[]%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifClEnclosed%")'>%AlbumPAifClEnclosed%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifClEnclosed[]%")'>%AlbumPAifClEnclosed[]%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifClEnclosedShort%")'>%AlbumPAifClEnclosedShort%</span>
                    <span class="token" @onclick='() => CopyToken("%AlbumPAifClEnclosedShort[]%")'>%AlbumPAifClEnclosedShort[]%</span>
                </div>
            </details>

            <div class="template-section">
                <div class="template-section-title">Spécifique à la piste</div>
                <div class="template-tokens">
                    <span class="token" @onclick='() => CopyToken("%TrackArtist%")'>%TrackArtist%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackComposer%")'>%TrackComposer%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackID%")'>%TrackID%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackNumber%")'>%TrackNumber%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackTitle%")'>%TrackTitle%</span>
                    <span class="token" @onclick='() => CopyToken("%ISRC%")'>%ISRC%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackFormat%")'>%TrackFormat%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackFormatWithQuality%")'>%TrackFormatWithQuality%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackFormatWithHiResQuality%")'>%TrackFormatWithHiResQuality%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackBitDepth%")'>%TrackBitDepth%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackSampleRate%")'>%TrackSampleRate%</span>
                </div>
            </div>

            <details class="template-subsection">
                <summary>Contrôle parental (piste)</summary>
                <div class="template-tokens">
                    <span class="token" @onclick='() => CopyToken("%TrackPA%")'>%TrackPA%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAShort%")'>%TrackPAShort%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifEx%")'>%TrackPAifEx%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifExShort%")'>%TrackPAifExShort%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifCl%")'>%TrackPAifCl%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifClShort%")'>%TrackPAifClShort%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAEnclosed%")'>%TrackPAEnclosed%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAEnclosed[]%")'>%TrackPAEnclosed[]%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAEnclosedShort%")'>%TrackPAEnclosedShort%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAEnclosedShort[]%")'>%TrackPAEnclosedShort[]%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifExEnclosed%")'>%TrackPAifExEnclosed%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifExEnclosed[]%")'>%TrackPAifExEnclosed[]%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifExEnclosedShort%")'>%TrackPAifExEnclosedShort%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifExEnclosedShort[]%")'>%TrackPAifExEnclosedShort[]%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifClEnclosed%")'>%TrackPAifClEnclosed%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifClEnclosed[]%")'>%TrackPAifClEnclosed[]%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifClEnclosedShort%")'>%TrackPAifClEnclosedShort%</span>
                    <span class="token" @onclick='() => CopyToken("%TrackPAifClEnclosedShort[]%")'>%TrackPAifClEnclosedShort[]%</span>
                </div>
            </details>

            <div class="template-section">
                <div class="template-section-title">Spécifique à la playlist</div>
                <div class="template-tokens">
                    <span class="token" @onclick='() => CopyToken("%PlaylistID%")'>%PlaylistID%</span>
                    <span class="token" @onclick='() => CopyToken("%PlaylistTitle%")'>%PlaylistTitle%</span>
                    <span class="token" @onclick='() => CopyToken("%Format%")'>%Format%</span>
                    <span class="token" @onclick='() => CopyToken("%FormatWithQuality%")'>%FormatWithQuality%</span>
                    <span class="token" @onclick='() => CopyToken("%FormatWithHiResQuality%")'>%FormatWithHiResQuality%</span>
                </div>
            </div>

            <div class="template-section">
                <div class="template-section-title">Spécifique au CD</div>
                <div class="template-tokens">
                    <span class="token" @onclick='() => CopyToken("%DiscNumber%")'>%DiscNumber%</span>
                </div>
            </div>

            <div class="template-hint">Cliquez sur une variable pour la copier</div>
        </div>
    </details>
</div>

<!-- Tagging Options -->
<div class="card">
    <div class="card-title">Options de tagage</div>
    <div class="settings-grid">
        <div class="setting-item"><input type="checkbox" @bind="S.AlbumTag" @bind:after="Save" /><label>Titre de l'album</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.AlbumArtistTag" @bind:after="Save" /><label>Artiste de l'album</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.ArtistTag" @bind:after="Save" /><label>Artiste de la piste</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.TrackTitleTag" @bind:after="Save" /><label>Titre de la piste</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.TrackTag" @bind:after="Save" /><label>Numéro de piste</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.TotalTracksTag" @bind:after="Save" /><label>Total des pistes</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.DiscTag" @bind:after="Save" /><label>Numéro de disque</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.TotalDiscsTag" @bind:after="Save" /><label>Total des disques</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.GenreTag" @bind:after="Save" /><label>Genre</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.YearTag" @bind:after="Save" /><label>Année</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.ReleaseDateTag" @bind:after="Save" /><label>Date de sortie</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.ComposerTag" @bind:after="Save" /><label>Compositeur</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.CopyrightTag" @bind:after="Save" /><label>Copyright</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.LabelTag" @bind:after="Save" /><label>Label</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.IsrcTag" @bind:after="Save" /><label>ISRC</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.UpcTag" @bind:after="Save" /><label>UPC / Code-barres</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.TypeTag" @bind:after="Save" /><label>Type de sortie</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.ExplicitTag" @bind:after="Save" /><label>Avertissement explicite</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.ImageTag" @bind:after="Save" /><label>Pochette</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.UrlTag" @bind:after="Save" /><label>URL</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.MergeArtistNames" @bind:after="Save" /><label>Fusionner les noms d'artistes</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.MergeArtistNamesInDirNames" @bind:after="Save" /><label>Fusionner dans les noms de dossiers</label></div>
    </div>

    <div style="margin-top:12px;">
        <div class="setting-item"><input type="checkbox" @bind="S.CommentTag" @bind:after="Save" /><label>Commentaire personnalisé</label></div>
        @if (S.CommentTag)
        {
            <div class="form-group" style="margin-top:8px;">
                <input type="text" @bind="S.CommentText" @bind:after="Save" placeholder="Texte du commentaire (%description% pour la description de l'album)" />
            </div>
        }
    </div>

    <div style="margin-top:12px;">
        <div class="setting-item"><input type="checkbox" @bind="S.ExplicitTagInTitle" @bind:after="Save" /><label>Tag 'Explicit' dans le titre</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.CleanTagInTitle" @bind:after="Save" /><label>Tag 'Clean' dans le titre</label></div>
    </div>
</div>

<!-- Artwork -->
<div class="card">
    <div class="card-title">Pochette</div>
    <div class="settings-grid">
        <div class="form-group">
            <label>Taille pochette intégrée</label>
            <select @bind="S.EmbeddedArtSize" @bind:after="Save">
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="150">150</option>
                <option value="230">230</option>
                <option value="300">300</option>
                <option value="600">600</option>
            </select>
        </div>
        <div class="form-group">
            <label>Taille pochette sauvegardée</label>
            <select @bind="S.SavedArtSize" @bind:after="Save">
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="150">150</option>
                <option value="230">230</option>
                <option value="300">300</option>
                <option value="600">600</option>
            </select>
        </div>
    </div>
    <div class="setting-item"><input type="checkbox" @bind="S.DontSaveArtworkToDisk" @bind:after="Save" /><label>Ne pas sauvegarder la pochette sur le disque</label></div>
</div>

<!-- Advanced -->
<div class="card">
    <div class="card-title">Options avancées</div>
    <div class="settings-grid">
        <div class="setting-item"><input type="checkbox" @bind="S.StreamableCheck" @bind:after="Save" /><label>Vérification de disponibilité</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.FixMD5s" @bind:after="Save" /><label>Corriger auto. les MD5 manquants</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.DownloadGoodies" @bind:after="Save" /><label>Télécharger les bonus</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.DownloadSpeed" @bind:after="Save" /><label>Afficher la vitesse</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.UseItemPosInPlaylist" @bind:after="Save" /><label>Utiliser les positions dans la playlist</label></div>
        <div class="setting-item"><input type="checkbox" @bind="S.LogFailedDownloads" @bind:after="Save" /><label>Journaliser les échecs</label></div>
    </div>

    <div class="form-group" style="margin-top:12px;">
        <label>Fichiers en double</label>
        <select @bind="S.DuplicateFileMode" @bind:after="Save">
            <option value="skip">Ignorer le téléchargement</option>
            <option value="rename">Renommer automatiquement</option>
            <option value="overwrite">Écraser le fichier existant</option>
        </select>
    </div>
</div>

<!-- App Access Password -->
<div class="card">
    <div class="card-title">Mot de passe d'accès</div>
    <p style="font-size:0.85em;color:var(--text-secondary);margin-bottom:12px;">
        Protégez votre application avec un mot de passe. Chaque nouvelle connexion devra le saisir avant d'accéder à l'interface.
    </p>

    @if (string.IsNullOrEmpty(S.AppAccessPasswordHash))
    {
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
            <span style="color:var(--text-secondary);font-size:0.85em;">Statut :</span>
            <span style="color:var(--text-secondary);font-size:0.85em;">Aucun mot de passe — l'application est accessible à tous</span>
        </div>
        <div style="display:flex;gap:8px;align-items:flex-end;">
            <div class="form-group" style="flex:1;margin:0;">
                <label>Nouveau mot de passe</label>
                <input type="password" @bind="_newAccessPassword" placeholder="Choisir un mot de passe..." />
            </div>
            <button class="btn btn-primary" style="height:38px;" @onclick="SetAccessPassword" disabled="@string.IsNullOrWhiteSpace(_newAccessPassword)">Activer</button>
        </div>
    }
    else
    {
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
            <span style="color:var(--text-secondary);font-size:0.85em;">Statut :</span>
            <span style="color:var(--success);font-size:0.85em;">Mot de passe actif — application protégée</span>
        </div>
        <div style="display:flex;gap:8px;align-items:flex-end;">
            <div class="form-group" style="flex:1;margin:0;">
                <label>Nouveau mot de passe</label>
                <input type="password" @bind="_newAccessPassword" placeholder="Changer le mot de passe..." />
            </div>
            <button class="btn btn-primary" style="height:38px;" @onclick="SetAccessPassword" disabled="@string.IsNullOrWhiteSpace(_newAccessPassword)">Modifier</button>
            <button class="btn btn-danger" style="height:38px;" @onclick="RemoveAccessPassword">Supprimer</button>
        </div>
    }

    @if (_accessPasswordSaved)
    {
        <div style="color:var(--success);font-size:0.85em;margin-top:8px;">@_accessPasswordMessage</div>
    }
</div>

@if (_showCopied)
{
    <div class="toast-notification">Copié : @_copiedToken</div>
}

@code {
    private Models.AppSettings S => SettingsSvc.Settings;
    private bool _showCopied;
    private string _copiedToken = "";
    private string _newAccessPassword = "";
    private bool _accessPasswordSaved;
    private string _accessPasswordMessage = "";

    private void Save() => SettingsSvc.Save();

    private async Task SetAccessPassword()
    {
        if (string.IsNullOrWhiteSpace(_newAccessPassword)) return;
        SettingsSvc.Update(s => s.AppAccessPasswordHash = AppGuardService.HashPassword(_newAccessPassword));
        _newAccessPassword = "";
        _accessPasswordMessage = "Mot de passe enregistré.";
        _accessPasswordSaved = true;
        StateHasChanged();
        await Task.Delay(3000);
        _accessPasswordSaved = false;
        StateHasChanged();
    }

    private async Task RemoveAccessPassword()
    {
        SettingsSvc.Update(s => s.AppAccessPasswordHash = "");
        _newAccessPassword = "";
        _accessPasswordMessage = "Mot de passe supprimé — application ouverte.";
        _accessPasswordSaved = true;
        StateHasChanged();
        await Task.Delay(3000);
        _accessPasswordSaved = false;
        StateHasChanged();
    }

    private async Task CopyToken(string token)
    {
        try
        {
            await JS.InvokeVoidAsync("copyToClipboard", token);
        }
        catch { }

        _copiedToken = token;
        _showCopied = true;
        StateHasChanged();

        await Task.Delay(1500);
        _showCopied = false;
        StateHasChanged();
    }
}
