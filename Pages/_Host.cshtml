@page "/"
@namespace QobuzDLX.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using QobuzDLX.Web.Services
@inject LocalizationService Loc
@* La détection de la langue du navigateur se fait dans un middleware (Program.cs), avant que
   cette page ne soit rendue : la vue n'a plus qu'à lire la langue courante. *@

<!DOCTYPE html>
<html lang="@Loc.Current">
<head>
    <meta charset="utf-8" />
    @* viewport-fit=cover : sans lui, env(safe-area-inset-*) vaut zéro sur les écrans à encoche.
       Le zoom utilisateur reste autorisé (pas de maximum-scale) pour l'accessibilité. *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#16213e" />
    <meta name="color-scheme" content="dark" />
    <title>@Loc["app.title"]</title>
    <base href="~/" />
    <link rel="stylesheet" href="css/app.css" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />
    <script src="_framework/blazor.server.js"></script>
    <script>
        window.copyToClipboard = function (text) {
            if (navigator.clipboard && window.isSecureContext) {
                return navigator.clipboard.writeText(text);
            }
            var ta = document.createElement("textarea");
            ta.value = text;
            ta.style.position = "fixed";
            ta.style.left = "-9999px";
            document.body.appendChild(ta);
            ta.select();
            document.execCommand("copy");
            document.body.removeChild(ta);
            return Promise.resolve();
        };

        // Appelé par LanguageSwitch : la bascule ne rechargeant pas la page, l'attribut lang du
        // document doit être mis à jour ici.
        window.setHtmlLang = function (lang) {
            document.documentElement.lang = lang;
        };

        // Journal de téléchargement : avec une file qui enchaîne les éléments, les nouvelles lignes
        // sortent sans arrêt du cadre visible. Le garde-fou sur l'élément évite une exception si le
        // rendu a retiré le nœud entre-temps.
        window.scrollToBottom = function (el) {
            if (el) el.scrollTop = el.scrollHeight;
        };
    </script>
</body>
</html>
