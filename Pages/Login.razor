@page "/login"
@using System.Net
@inject QobuzApiService Api
@inject SettingsService Settings
@inject NavigationManager Nav
@inherits LocalizedComponentBase

<div class="auth-card">
    <div class="card">
        <div style="text-align:center;margin-bottom:20px;">
            <h2 style="color:var(--accent);font-size:1.8em;">QBDLX</h2>
            <p style="color:var(--text-secondary);font-size:0.85em;">@Loc["login.subtitle"]</p>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div style="background:rgba(231,76,60,0.15);border:1px solid #c0392b;border-radius:6px;padding:10px;margin-bottom:12px;font-size:0.85em;color:#e74c3c;">
                @_error
            </div>
        }

        @if (_useToken)
        {
            <div class="form-group">
                <label>@Loc["login.token"]</label>
                <input type="password" @bind="_token" placeholder='@Loc["login.tokenPlaceholder"]' />
            </div>
        }
        else
        {
            <div class="form-group">
                <label>@Loc["login.email"]</label>
                <input type="email" @bind="_email" placeholder='@Loc["login.emailPlaceholder"]' />
            </div>
            <div class="form-group">
                <label>@Loc["login.password"]</label>
                <input type="password" @bind="_password" placeholder='@Loc["login.passwordPlaceholder"]' />
            </div>
        }

        <button class="btn btn-primary" style="width:100%;margin-top:8px;" @onclick="DoLogin" disabled="@_loading">
            @(_loading ? Loc["login.submitting"] : Loc["login.submit"])
        </button>

        <div style="text-align:center;margin-top:12px;">
            <button class="btn btn-sm btn-secondary" @onclick="() => _useToken = !_useToken">
                @(_useToken ? Loc["login.useEmail"] : Loc["login.useToken"])
            </button>
        </div>

        <details style="margin-top:16px;">
            <summary style="color:var(--text-secondary);font-size:0.85em;cursor:pointer;">@Loc["login.customCredentials"]</summary>
            <div style="margin-top:8px;">
                <div class="form-group">
                    <label>@Loc["login.appId"]</label>
                    <input type="text" @bind="_customAppId" placeholder="App ID" />
                </div>
                <div class="form-group">
                    <label>@Loc["login.appSecret"]</label>
                    <input type="text" @bind="_customAppSecret" placeholder="App Secret" />
                </div>
            </div>
        </details>
    </div>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private string _token = "";
    private string _customAppId = "";
    private string _customAppSecret = "";
    private string _error = "";
    private bool _loading;
    private bool _useToken;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        var s = Settings.Settings;
        _email = s.Email;
        _customAppId = s.AppId;
        _customAppSecret = s.AppSecret;
        _useToken = s.UseTokenLogin;

        // Auto-login if token and secret are persisted
        if (!string.IsNullOrEmpty(s.UserAuthToken) && !string.IsNullOrEmpty(s.AppId) && !string.IsNullOrEmpty(s.AppSecret))
        {
            Api.SetCredentials(s.AppId, s.AppSecret, s.UserAuthToken);
            Nav.NavigateTo("/", forceLoad: false);
        }
    }

    private bool HasCustomCredentials =>
        !string.IsNullOrEmpty(_customAppId) && !string.IsNullOrEmpty(_customAppSecret);

    private async Task DoLogin()
    {
        _error = "";
        _loading = true;

        try
        {
            // Validate inputs early
            if (_useToken)
            {
                if (string.IsNullOrWhiteSpace(_token)) { _error = Loc["login.error.noToken"]; return; }
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_email)) { _error = Loc["login.error.noEmail"]; return; }
                if (string.IsNullOrWhiteSpace(_password)) { _error = Loc["login.error.noPassword"]; return; }
            }

            // Le couple app_id / app_secret est établi avant le login, puis le login n'est tenté
            // qu'une fois : un 401 ne peut plus signifier qu'un app_id refusé, il désigne donc de
            // mauvais identifiants — et un mauvais mot de passe ne se rejoue plus sur chaque repli.
            (string AppId, string AppSecret)? app = HasCustomCredentials
                ? (_customAppId, _customAppSecret)
                : await Api.ResolveAppCredentialsAsync();

            if (app is not var (appId, appSecret))
            {
                _error = Loc["login.error.noAppCredentials"];
                return;
            }

            Models.QobuzLoginResponse result = _useToken
                ? await Api.LoginWithTokenAsync(appId, _token)
                : await Api.LoginWithEmailAsync(appId, _email, _password);

            ApplyLogin(appId, appSecret, result);
        }
        catch (HttpRequestException ex) when (ex.StatusCode is HttpStatusCode.BadRequest
                                                  or HttpStatusCode.Unauthorized
                                                  or HttpStatusCode.Forbidden)
        {
            _error = Loc["login.error.invalidCredentials"];
        }
        catch (HttpRequestException)
        {
            _error = Loc["login.error.network"];
        }
        catch (Exception ex)
        {
            _error = Loc.T("login.error.generic", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyLogin(string appId, string appSecret, Models.QobuzLoginResponse result)
    {
        Api.SetCredentials(appId, appSecret, result.UserAuthToken!);

        Settings.Update(s => {
            s.AppId = appId;
            s.AppSecret = appSecret;
            s.UserAuthToken = result.UserAuthToken!;
            s.UserId = result.User?.Id.ToString() ?? "";
            s.UserDisplayName = result.User?.DisplayName ?? "";
            s.Email = _useToken ? "" : _email;
            s.UseTokenLogin = _useToken;
            s.UserLabel = result.User?.Credential?.Parameters?.ShortLabel ?? "";
        });

        Nav.NavigateTo("/", forceLoad: true);
    }
}
