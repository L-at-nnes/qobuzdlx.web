@page "/login"
@inject QobuzApiService Api
@inject SettingsService Settings
@inject NavigationManager Nav

<div style="width: 400px;">
    <div class="card">
        <div style="text-align:center;margin-bottom:20px;">
            <h2 style="color:var(--accent);font-size:1.8em;">QBDLX</h2>
            <p style="color:var(--text-secondary);font-size:0.85em;">Qobuz Downloader - Édition Web</p>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div style="background:rgba(231,76,60,0.15);border:1px solid #c0392b;border-radius:6px;padding:10px;margin-bottom:12px;font-size:0.85em;color:#e74c3c;">
                @_error
            </div>
        }

        @if (_useToken)
        {
            <div class="form-group">
                <label>Jeton d'authentification</label>
                <input type="password" @bind="_token" placeholder="jeton" />
            </div>
        }
        else
        {
            <div class="form-group">
                <label>Email</label>
                <input type="email" @bind="_email" placeholder="e-mail" />
            </div>
            <div class="form-group">
                <label>Mot de passe</label>
                <input type="password" @bind="_password" placeholder="mot de passe" />
            </div>
        }

        <button class="btn btn-primary" style="width:100%;margin-top:8px;" @onclick="DoLogin" disabled="@_loading">
            @(_loading ? "Connexion..." : "CONNEXION")
        </button>

        <div style="text-align:center;margin-top:12px;">
            <button class="btn btn-sm btn-secondary" @onclick="() => _useToken = !_useToken">
                @(_useToken ? "Connexion par e-mail" : "Connexion par jeton")
            </button>
        </div>

        <details style="margin-top:16px;">
            <summary style="color:var(--text-secondary);font-size:0.85em;cursor:pointer;">App ID / Secret personnalisés</summary>
            <div style="margin-top:8px;">
                <div class="form-group">
                    <label>App ID (laisser vide pour auto)</label>
                    <input type="text" @bind="_customAppId" placeholder="App ID" />
                </div>
                <div class="form-group">
                    <label>App Secret (laisser vide pour auto)</label>
                    <input type="text" @bind="_customAppSecret" placeholder="App Secret" />
                </div>
            </div>
        </details>
    </div>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private string _token = "";
    private string _customAppId = "";
    private string _customAppSecret = "";
    private string _error = "";
    private bool _loading;
    private bool _useToken;

    protected override void OnInitialized()
    {
        var s = Settings.Settings;
        _email = s.Email;
        _customAppId = s.AppId;
        _customAppSecret = s.AppSecret;
        _useToken = s.UseTokenLogin;

        // Auto-login if token and secret are persisted
        if (!string.IsNullOrEmpty(s.UserAuthToken) && !string.IsNullOrEmpty(s.AppId) && !string.IsNullOrEmpty(s.AppSecret))
        {
            Api.SetCredentials(s.AppId, s.AppSecret, s.UserAuthToken);
            Nav.NavigateTo("/", forceLoad: false);
        }
    }

    private async Task DoLogin()
    {
        _error = "";
        _loading = true;

        try
        {
            // Validate inputs early
            if (_useToken)
            {
                if (string.IsNullOrWhiteSpace(_token)) { _error = "Aucun jeton fourni"; return; }
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_email)) { _error = "Aucun e-mail fourni"; return; }
                if (string.IsNullOrWhiteSpace(_password)) { _error = "Aucun mot de passe fourni"; return; }
            }

            bool hasCustomCredentials = !string.IsNullOrEmpty(_customAppId) && !string.IsNullOrEmpty(_customAppSecret);

            if (hasCustomCredentials)
            {
                // User provided custom credentials — use them directly, no fallback
                await LoginWithCredentials(_customAppId, _customAppSecret);
                return;
            }

            // Try dynamic resolution first
            try
            {
                string appId = await Api.GetAppIdAsync();
                string appSecret = await TryLoginAndResolveSecret(appId);
                ApplyLogin(appId, appSecret);
                return;
            }
            catch (Exception ex)
            {
                // Dynamic resolution failed — try fallbacks
                System.Diagnostics.Debug.WriteLine($"Dynamic resolution failed: {ex.Message}");
            }

            // Try each fallback pair
            foreach (var (fbAppId, fbAppSecret) in QobuzApiService.GetFallbackCredentials())
            {
                try
                {
                    await LoginWithCredentials(fbAppId, fbAppSecret);
                    return;
                }
                catch
                {
                    // This pair didn't work, try next
                }
            }

            _error = "Échec de connexion : aucun identifiant d'application valide trouvé. Essayez de fournir un App ID et Secret personnalisés.";
        }
        catch (HttpRequestException)
        {
            _error = "Impossible de joindre les serveurs Qobuz. Vérifiez votre connexion.";
        }
        catch (Exception ex)
        {
            _error = ex.Message.Contains("401") || ex.Message.Contains("Invalid")
                ? "Identifiants invalides. Vérifiez votre e-mail/mot de passe ou jeton."
                : $"Échec de connexion : {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<string> TryLoginAndResolveSecret(string appId)
    {
        Models.QobuzLoginResponse result = _useToken
            ? await Api.LoginWithTokenAsync(appId, _token)
            : await Api.LoginWithEmailAsync(appId, _email, _password);

        string appSecret = await Api.GetAppSecretAsync(appId, result.UserAuthToken!);
        _loginResult = result;
        return appSecret;
    }

    private async Task LoginWithCredentials(string appId, string appSecret)
    {
        Models.QobuzLoginResponse result = _useToken
            ? await Api.LoginWithTokenAsync(appId, _token)
            : await Api.LoginWithEmailAsync(appId, _email, _password);

        _loginResult = result;
        ApplyLogin(appId, appSecret);
    }

    private void ApplyLogin(string appId, string appSecret)
    {
        var result = _loginResult!;
        Api.SetCredentials(appId, appSecret, result.UserAuthToken!);

        Settings.Update(s => {
            s.AppId = appId;
            s.AppSecret = appSecret;
            s.UserAuthToken = result.UserAuthToken!;
            s.UserId = result.User?.Id.ToString() ?? "";
            s.UserDisplayName = result.User?.DisplayName ?? "";
            s.Email = _useToken ? "" : _email;
            s.UseTokenLogin = _useToken;
            s.UserLabel = result.User?.Credential?.Parameters?.ShortLabel ?? "";
        });

        Nav.NavigateTo("/", forceLoad: true);
    }

    private Models.QobuzLoginResponse? _loginResult;
}
